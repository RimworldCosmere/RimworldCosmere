<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <Cosmere.Core.Quest.CosmereQuestDef>
        <defName>Cosmere_Scadrial_Quest_InquisitorHunt</defName>
        <label>A Steel Inquisitor Is Hunting</label>
        <description>Something with spikes through its eyes has been asking after you by name, three villages over and closing.\n\nInquisitors do not negotiate and they are not sent to negotiate. This one has been given your colony and will not be recalled while any of you are breathing. It has taken a waypoint on the road and is working outward from it.\n\nYou were not offered this. Go and end it, or wait and let it come to you.</description>

        <kind>Threat</kind>
        <subject>Colony</subject>
        <eras>
            <li>Cosmere_Scadrial_Era_PreCatacendre</li>
        </eras>

        <targetFaction>Cosmere_Scadrial_Faction_FinalEmpireNPC</targetFaction>

        <selectionWeight>1.0</selectionWeight>
        <!-- Never offered, so there is no acceptance window to expire. -->
        <expireAfterDays>0</expireAfterDays>
        <cooldownDays>40</cooldownDays>
        <challengeRating>4</challengeRating>
        <minColonists>3</minColonists>
        <minDaysElapsed>20</minDaysElapsed>

        <stages>
            <li>
                <key>travel</key>
                <descriptionKey>CS_Quest_Inquisitor_Stage_Travel</descriptionKey>
                <objective Class="Cosmere.Core.Quest.Objective.TravelToSiteObjective">
                    <sitePart>Outpost</sitePart>
                    <siteLabelKey>CS_Quest_Inquisitor_Site</siteLabelKey>
                    <minTiles>4</minTiles>
                    <maxTiles>12</maxTiles>
                    <threatPoints>800</threatPoints>
                </objective>
            </li>
            <li>
                <key>clear</key>
                <descriptionKey>CS_Quest_Inquisitor_Stage_Clear</descriptionKey>
                <objective Class="Cosmere.Core.Quest.Objective.ClearSiteObjective" />
            </li>
        </stages>

        <rewards>
            <li Class="Cosmere.Core.Quest.Reward.GodMetalReward">
                <metal>Atium</metal>
                <countMin>1</countMin>
                <countMax>2</countMax>
                <nearColonist>true</nearColonist>
            </li>
        </rewards>

        <onFailure Class="Cosmere.Core.Quest.Outcome.GoodwillOutcome">
            <goodwillChange>-10</goodwillChange>
        </onFailure>
    </Cosmere.Core.Quest.CosmereQuestDef>
</Defs>
