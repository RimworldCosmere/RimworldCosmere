        </requiredMemes>
    </PreceptDef>

    <!-- ===== JAGGENISM ===== -->

    <!-- Sovereign's Blessing: Honoring the masked figure who brought warmth -->
    <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
