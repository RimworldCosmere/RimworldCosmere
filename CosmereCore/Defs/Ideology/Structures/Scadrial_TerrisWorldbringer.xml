<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <MemeDef ParentName="Cosmere_StructureBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_Structure_TerrisWorldbringer</defName>
        <label>Terris Worldbringer Faith</label>
        <description>Knowledge is sacred. Memory is duty. The Worldbringers and Keepers of Terris preserved knowledge through a thousand years of oppression, waiting for the Hero of Ages.</description>
        <iconPath>UI/Ideology/Cosmere/TerrisWorldbringer</iconPath>
        <deityCount>1</deityCount>
        <worshipRoomLabel>archive</worshipRoomLabel>
        <generalRules>
            <rulesStrings>
                <li>r_ideoName(p=99)->[globalAdjective] [packIdeoName]</li>
                <li>r_ideoName(p=99)->[memeAdjective] [packIdeoName]</li>
                <li>r_ideoName(p=99)->[packAdjective] [packIdeoName]</li>
                <li>r_ideoName(p=99)->[packIdeoName]</li>
                <li>memeLeaderNoun->keeper</li>
                <li>memeLeaderNoun->worldbringer</li>
                <li>memeLeaderNoun->synod elder</li>
                <li>memeLeaderAdjective->wise</li>
                <li>memeLeaderAdjective->remembering</li>
                <li>memeLeaderAdjective->preserving</li>
                <li>memeMoralist->keeper</li>
                <li>memeMoralist->worldbringer</li>
                <li>memeMoralist->steward</li>
            </rulesStrings>
        </generalRules>
        <descriptionMaker>
            <patterns>
                <li><def>TheistMyth</def></li>
            </patterns>
            <constants>
                <li><key>structure_cosmere_terrisworldbringer</key><value>true</value></li>
            </constants>
        </descriptionMaker>
        <fixedDeityNameTypes>
            <li>
                <name>The Hero</name>
                <type>the one who would come</type>
            </li>
            <li>
                <name>Preservation's Chosen</name>
                <type>the prophesied</type>
            </li>
            <li>
                <name>The One Who Would Come</name>
                <type>savior of all</type>
            </li>
        </fixedDeityNameTypes>
        <symbolPacks>
            <li>
                <ideoName>Worldbringers</ideoName>
                <adjective>worldbringer</adjective>
                <member>worldbringer</member>
                <prefix>true</prefix>
            </li>
            <li>
                <ideoName>Keepers</ideoName>
                <adjective>keeper</adjective>
                <member>keeper</member>
                <prefix>true</prefix>
            </li>
            <li>
                <ideoName>The Synod</ideoName>
                <adjective>synod</adjective>
                <member>steward</member>
                <prefix>true</prefix>
            </li>
            <li>
                <ideoName>Terris Faith</ideoName>
                <adjective>Terris</adjective>
                <member>Terrisman</member>
                <prefix>true</prefix>
            </li>
        </symbolPacks>
    </MemeDef>
</Defs>
