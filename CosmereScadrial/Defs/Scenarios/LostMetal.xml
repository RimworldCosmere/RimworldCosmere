              <firstName>Waxillium</firstName>
              <nickName>Wax</nickName>
              <lastName>Ladrian</lastName>
              <age>50</age>
              <gender>Male</gender>
              <xenotype>Cosmere_Scadrial_Xenotype_Scadrian</xenotype>
              <relations>
                <li><def>Spouse</def><to>Steris</to></li>
              </relations>
              <genes>
                <li>Cosmere_Scadrial_Gene_MistingSteel</li>
                <li>Cosmere_Scadrial_Gene_FerringIron</li>
              </genes>
              <traits>
                <li><def>Tough</def><degree>0</degree></li>
                <li><def>Nerves</def><degree>2</degree></li>
              </traits>
              <skills>
                <li><def>Shooting</def><level>20</level></li>
                <li><def>Melee</def><level>12</level></li>
                <li><def>Intellectual</def><level>12</level></li>
              </skills>
            </li>
            <li>
              <firstName>Wayne</firstName>
              <age>38</age>
              <gender>Male</gender>
              <xenotype>Cosmere_Scadrial_Xenotype_Skaa</xenotype>
              <genes>
