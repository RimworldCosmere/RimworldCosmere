            <Cosmere_Scadrial_Faction_FinalEmpireNPC>-100</Cosmere_Scadrial_Faction_FinalEmpireNPC>
          </relations>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The armies have been spotted. Straff Venture from the north. Ashweather Cett from the west. Koloss from the east. Luthadel's walls are thick, but your forces are thin. Vin watches from the rooftops. Elend reads another book on governance. Breeze pours himself a drink. The siege begins.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="Cosmere.Core.DefModExtension.Shards">
        <shards>
          <li>Ruin</li>
          <li>Preservation</li>
        </shards>
        <allowChange>False</allowChange>
      </li>
      <li Class="Cosmere.Core.DefModExtension.ScenarioEra">
        <era>Cosmere_Scadrial_Era_PreCatacendre</era>
      </li>
    </modExtensions>
  </ScenarioDef>
