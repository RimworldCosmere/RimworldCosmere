            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_HouseVenture</b>
            <goodwill>-100</goodwill>
          </li>
        </between>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The red sun hangs low. Ash drifts like snow, but there is no beauty in it. The koloss are loose, the Inquisitors hunt freely, and Ruin's influence grows. Your colony may be the last bastion of civilization left standing. Hold. Endure. And pray that someone, somewhere, finds the answer.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="Cosmere.Core.DefModExtension.Shards">
        <shards>
          <li>Ruin</li>
          <li>Preservation</li>
        </shards>
        <allowChange>False</allowChange>
      </li>
      <li Class="Cosmere.Core.DefModExtension.ScenarioEra">
        <era>Cosmere_Scadrial_Era_PreCatacendre</era>
      </li>
    </modExtensions>
  </ScenarioDef>
</Defs>
