<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <PawnKindDef ParentName="BasePlayerPawnKind">
        <defName>Cosmere_Scadrial_PawnKind_Noble</defName>
        <!-- Names its own people, so the faction's set must not be added on top: chances are
         summed, and a Skaa kind in a noble house came out Noble half the time. This is
         what lets a great house keep skaa without its lords becoming skaa. -->
        <useFactionXenotypes>false</useFactionXenotypes>
        <label>scadrian noble</label>
        <race>Human</race>
        <xenotypeSet>
            <xenotypeChances>
                <Cosmere_Scadrial_Xenotype_Noble>1</Cosmere_Scadrial_Xenotype_Noble>
            </xenotypeChances>
        </xenotypeSet>
        <combatPower>45</combatPower>
        <apparelTags>
            <li>IndustrialBasic</li>
        </apparelTags>
        <apparelMoney>900~1800</apparelMoney>
        <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
        <gearHealthRange>0.2~0.8</gearHealthRange>
        <initialResistanceRange>0.2~0.8</initialResistanceRange>
        <initialWillRange>0.2~0.8</initialWillRange>
        <inventoryOptions>
            <skipChance>1</skipChance>
        </inventoryOptions>
    </PawnKindDef>

