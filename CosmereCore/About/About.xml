<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
    <name>Cosmere - Core</name>
    <description>The shared Investiture and Connection framework behind every Cosmere mod. On its own it adds the plumbing, not the powers. Install a Shardworld mod for those.</description>
    <authors>
        <li>CryptikLemur</li>
        <li>Luucid</li>
    </authors>
    <supportedVersions>
        <li>1.6</li>
    </supportedVersions>
    <packageId>Cosmere.Core</packageId>
    <modDependencies>
        <li>
            <packageId>Ludeon.RimWorld.Biotech</packageId>
            <displayName>Biotech</displayName>
        </li>
        <li>
            <packageId>concordlib.concord</packageId>
            <displayName>Concord</displayName>
            <downloadUrl>https://github.com/ConcordLib/RimWorld/releases/latest</downloadUrl>
        </li>
        <li>
            <packageId>RimWorks.RimLogging</packageId>
            <displayName>RimLogging</displayName>
            <steamWorkshopUrl>steam://url/CommunityFilePage/3733484696</steamWorkshopUrl>
            <downloadUrl>https://github.com/RimWorks/rimworld-logging-framework/releases/latest</downloadUrl>
        </li>
    </modDependencies>
    <forceLoadAfter>
        <li>Ludeon.RimWorld.Biotech</li>
        <li>concordlib.concord</li>
        <li>RimWorks.RimLogging</li>
    </forceLoadAfter>
    <!-- Optional dev tools. Quickstarts also gates a loadFolders.xml folder holding
         Cosmere's own quickstarts. -->
    <loadAfter>
        <li>rimworks.quickstarts</li>
        <li>rimworks.pickle</li>
        <li>RimWorks.RimObs</li>
    </loadAfter>
</ModMetaData>