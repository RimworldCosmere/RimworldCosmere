<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThoughtDef>
        <defName>Cosmere_Roshar_Thought_OathSpoken</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>spoke an oath</label>
                <description>I spoke the words. I feel the bond strengthening within me.</description>
                <baseMoodEffect>15</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>Cosmere_Roshar_Thought_WitnessedOathPositive</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>3</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>witnessed an oath-speaking</label>
                <description>I saw the Stormlight blaze as the oath was spoken. It was... inspiring.</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>Cosmere_Roshar_Thought_WitnessedOathJealous</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>3</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>jealous of oath-speaker</label>
                <description>Why them and not me? The Stormlight should be mine.</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>
</Defs>
