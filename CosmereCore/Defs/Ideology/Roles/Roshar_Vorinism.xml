<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Vorin Monarch: single leader, king or queen depending on ideo gender -->
    <PreceptDef ParentName="PreceptRoleSingleBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_VorinMonarch</defName>
        <label>monarch</label>
        <description>The crowned ruler of a Vorin kingdom. By Almighty's decree the throne is held through conquest and covenant, the monarch leading armies and presiding over the Devotaries.</description>
        <iconPath>UI/Roles/Leader</iconPath>
        <leaderRole>true</leaderRole>
        <impact>High</impact>
        <displayOrderInImpact>1000</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <classicExtra>false</classicExtra>
        <canRemoveInUI>false</canRemoveInUI>
        <restrictToSupremeGenderChance>0.5</restrictToSupremeGenderChance>
        <expectationsOffset>2</expectationsOffset>
        <requiredMemes>
            <li>Cosmere_Structure_Vorinism</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.3</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>NegotiationAbility</statDef>
                <modifier>0.4</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>LeaderSpeech</li>
            <li>WorkDrive</li>
            <li>CombatCommand</li>
            <li>Trial</li>
        </grantedAbilities>
        <roleTags>
            <li>Leader</li>
        </roleTags>
    </PreceptDef>

    <!-- Ardent: moralist in grey robes, cannot own property, teaches devotaries -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_Ardent</defName>
        <label>ardent</label>
        <description>A shaven scholar of Vorinism, robed in grey. Ardents teach the Devotaries, tend to the spiritual needs of the faithful, and preserve the knowledge that will prepare humanity for the next Desolation.</description>
        <iconPath>UI/Roles/Moralist</iconPath>
        <nameMaker>NamerRoleMoralist</nameMaker>
        <impact>Medium</impact>
        <displayOrderInImpact>800</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <maxCount>6</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_Vorinism</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Intellectual>5</Intellectual>
                    <Social>5</Social>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>GlobalLearningFactor</statDef>
                <modifier>0.2</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>ConversionPower</statDef>
                <modifier>0.25</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>Convert</li>
            <li>Counsel</li>
            <li>Reassure</li>
            <li>ConversionRitual</li>
        </grantedAbilities>
        <roleRequiredWorkTags>
            <li>Social</li>
        </roleRequiredWorkTags>
    </PreceptDef>

    <!-- Highprince: Alethi noble-general, male-led, combat leader -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_Highprince</defName>
        <label>highprince</label>
        <description>A lighteyed warlord who rules a princedom in the monarch's name. Highprinces lead armies to the Shattered Plains and answer to the crown through war and contest.</description>
        <iconPath>UI/Roles/SpecialistMelee</iconPath>
        <nameMaker>NamerRoleBrawler</nameMaker>
        <impact>High</impact>
        <displayOrderInImpact>700</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <maxCount>5</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_Vorinism</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_SupremeGender">
                <labelKey>RoleRequirementLabelSupremeGender</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Melee>6</Melee>
                    <Shooting>6</Shooting>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>MeleeHitChance</statDef>
                <modifier>4</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.2</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>CombatCommand</li>
            <li>WorkDrive</li>
        </grantedAbilities>
        <roleRequiredWorkTags>
            <li>Violent</li>
        </roleRequiredWorkTags>
    </PreceptDef>

</Defs>
