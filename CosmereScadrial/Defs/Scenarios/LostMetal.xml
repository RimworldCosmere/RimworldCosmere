          <count>3</count>
        </li>

        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>800</count>
        </li>

        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>

        <li Class="Cosmere.Core.ScenarioPart.Parts.ScenPart_ScenarioProgression">
          <def>Cosmere_ScenPart_ScenarioProgression</def>
          <progression>Cosmere_Scadrial_Progression_LostMetal</progression>
        </li>

        <li Class="Cosmere.Core.ScenarioPart.Parts.ScenPart_FactionRelations">
          <def>Cosmere_ScenPart_FactionRelations</def>
          <relations>
            <Cosmere_Scadrial_Faction_Elendel>60</Cosmere_Scadrial_Faction_Elendel>
            <Cosmere_Scadrial_Faction_Malwish>30</Cosmere_Scadrial_Faction_Malwish>
            <Cosmere_Scadrial_Faction_TheSet>-100</Cosmere_Scadrial_Faction_TheSet>
            <Cosmere_Scadrial_Faction_HouseHasting>-20</Cosmere_Scadrial_Faction_HouseHasting>
            <Cosmere_Scadrial_Faction_HouseTekiel>0</Cosmere_Scadrial_Faction_HouseTekiel>
            <Cosmere_Scadrial_Faction_HouseCett>0</Cosmere_Scadrial_Faction_HouseCett>
            <Cosmere_Scadrial_Faction_HouseErikell>0</Cosmere_Scadrial_Faction_HouseErikell>
            <Cosmere_Scadrial_Faction_HouseInnate>-40</Cosmere_Scadrial_Faction_HouseInnate>
            <Cosmere_Scadrial_Faction_HouseDemoux>40</Cosmere_Scadrial_Faction_HouseDemoux>
            <Cosmere_Scadrial_Faction_HouseHammondess>40</Cosmere_Scadrial_Faction_HouseHammondess>
            <Cosmere_Scadrial_Faction_RoughsOutlaws>-100</Cosmere_Scadrial_Faction_RoughsOutlaws>
          </relations>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>For years every thread anyone pulled came apart in their hands. This one holds, and what is on the end of it is not a smuggling ring. Factories with no owner. Bloodlines tracked across four generations in a ledger. A recruitment programme with a curriculum.\n\nHarmony has gone quiet about it. Not evasive - quiet, in the way of someone who has already run the position out and does not want to say what he found.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="Cosmere.Core.DefModExtension.Shards">
        <shards>
          <li>Harmony</li>
        </shards>
        <allowChange>False</allowChange>
      </li>
      <li Class="Cosmere.Core.DefModExtension.ScenarioEra">
        <era>Cosmere_Scadrial_Era_LostMetal</era>
      </li>
    </modExtensions>
  </ScenarioDef>
</Defs>
