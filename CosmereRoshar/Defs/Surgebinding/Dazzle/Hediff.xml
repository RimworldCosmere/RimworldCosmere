<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef ParentName="Cosmere_Roshar_Hediff_BaseHediff">
        <defName>Cosmere_Roshar_Hediff_Dazzled</defName>
        <label>dazzled</label>
        <description>This person's vision has been seared by a burst of concentrated Stormlight. The world is a swimming mess of white spots and phantom shapes. They blink and blink but the afterimages will not fade, and every movement in their peripheral vision is a blur they cannot identify. Fighting like this is almost impossible.</description>
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>480~480</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
                    <MeleeHitChance>-0.25</MeleeHitChance>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.30</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>
