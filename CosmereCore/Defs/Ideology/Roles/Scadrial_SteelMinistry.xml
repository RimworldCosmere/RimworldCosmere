<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Lord Prelan: head of the Steel Ministry, second only to the Lord Ruler -->
    <PreceptDef ParentName="PreceptRoleSingleBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_LordPrelan</defName>
        <label>lord prelan</label>
        <description>Head of the Steel Ministry, second in authority only to the Lord Ruler himself. The Lord Prelan oversees the four Cantons and commands the full weight of imperial orthodoxy.</description>
        <iconPath>UI/Roles/Moralist</iconPath>
        <leaderRole>true</leaderRole>
        <impact>High</impact>
        <displayOrderInImpact>900</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <classicExtra>false</classicExtra>
        <canRemoveInUI>false</canRemoveInUI>
        <restrictToSupremeGenderChance>1</restrictToSupremeGenderChance>
        <convertPowerFactor>3</convertPowerFactor>
        <expectationsOffset>2</expectationsOffset>
        <requiredMemes>
            <li>Cosmere_Structure_SteelMinistry</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_SupremeGender">
                <labelKey>RoleRequirementLabelSupremeGender</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Intellectual>6</Intellectual>
                    <Social>6</Social>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.4</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>NegotiationAbility</statDef>
                <modifier>0.4</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>ConversionPower</statDef>
                <modifier>0.5</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>LeaderSpeech</li>
            <li>WorkDrive</li>
            <li>Trial</li>
            <li>Convert</li>
            <li>Counsel</li>
        </grantedAbilities>
        <roleTags>
            <li>Moralist</li>
        </roleTags>
        <roleRequiredWorkTags>
            <li>Social</li>
        </roleRequiredWorkTags>
    </PreceptDef>

    <!-- High Prelan: one per Canton (Orthodoxy, Finance, Inquisition, Resource) -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_HighPrelan</defName>
        <label>high prelan</label>
        <description>A Canton head of the Steel Ministry. The four High Prelans lead the Cantons of Orthodoxy, Finance, Inquisition, and Resource, enforcing the Lord Ruler's will across the Final Empire.</description>
        <iconPath>UI/Roles/Moralist</iconPath>
        <nameMaker>NamerRoleMoralist</nameMaker>
        <impact>Medium</impact>
        <displayOrderInImpact>800</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <maxCount>4</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_SteelMinistry</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Intellectual>5</Intellectual>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.25</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>GlobalLearningFactor</statDef>
                <modifier>0.25</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>ResearchSpeed</statDef>
                <modifier>0.2</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>Counsel</li>
            <li>Reassure</li>
        </grantedAbilities>
    </PreceptDef>

    <!-- Steel Inquisitor: spiked enforcer wielding Allomancy through Hemalurgy -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_SteelInquisitor</defName>
        <label>steel inquisitor</label>
        <description>A spiked enforcer of the Lord Ruler's will. Steel Inquisitors carry Hemalurgic spikes driven through their eyes, granting them stolen Allomantic power in service of the Final Empire.</description>
        <iconPath>UI/Roles/SpecialistMelee</iconPath>
        <nameMaker>NamerRoleBrawler</nameMaker>
        <impact>High</impact>
        <displayOrderInImpact>700</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <maxCount>3</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_SteelMinistry</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_SupremeGender">
                <labelKey>RoleRequirementLabelSupremeGender</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Melee>6</Melee>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>MeleeHitChance</statDef>
                <modifier>6</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>MeleeDodgeChance</statDef>
                <modifier>4</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>PainShockThreshold</statDef>
                <modifier>0.3</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>IncomingDamageFactor</statDef>
                <modifier>-0.15</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>BerserkTrance</li>
            <li>CombatCommand</li>
        </grantedAbilities>
        <roleRequiredWorkTags>
            <li>Violent</li>
        </roleRequiredWorkTags>
        <roleTags>
            <li>MeleeSpecialist</li>
        </roleTags>
    </PreceptDef>

    <!-- Obligator: bureaucrat and witness to imperial contract -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_Obligator</defName>
        <label>obligator</label>
        <description>A bureaucrat of the Steel Ministry. Obligators witness contracts, record transactions, and serve as the Lord Ruler's eyes in every corner of the Final Empire. No agreement holds without an obligator's seal.</description>
        <iconPath>UI/Roles/Moralist</iconPath>
        <nameMaker>NamerRoleMoralist</nameMaker>
        <impact>Medium</impact>
        <displayOrderInImpact>600</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <maxCount>8</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_SteelMinistry</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Social>5</Social>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.15</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>TradePriceImprovement</statDef>
                <modifier>0.15</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>NegotiationAbility</statDef>
                <modifier>0.2</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>Convert</li>
            <li>ConversionRitual</li>
        </grantedAbilities>
        <roleRequiredWorkTags>
            <li>Social</li>
        </roleRequiredWorkTags>
    </PreceptDef>

</Defs>
