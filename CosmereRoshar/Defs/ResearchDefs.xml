<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ResearchProjectDef>
        <defName>Cosmere_Roshar_SphereProduction</defName>
        <label>Sphere Production</label>
        <description>By replicating Rosharan techniques, your colonists have learned to produce gemstone spheres—polished, standardized orbs capable of holding Stormlight. Though originally used as both currency and power sources, these spheres serve as versatile vessels for light, energy, and craftwork across shardworlds.</description>
        <tab>Cosmere</tab>
        <baseCost>400</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>Cosmere_Gem_Cutting</li>
        </prerequisites>
        <researchViewX>2.00</researchViewX>
        <researchViewY>3.00</researchViewY>
        <generalRules>
            <rulesStrings>
                <li>subject->sphere crafting</li>
                <li>subject_story->carefully encased gemstones in glass, hoping to capture the storm</li>
                <li>subject_story->accidentally shattered a valuable sphere</li>
                <li>subject_story->traded spheres with a merchant</li>
                <li>subject_gerund->encasing gemstones in spheres</li>
            </rulesStrings>
        </generalRules>
    </ResearchProjectDef>

