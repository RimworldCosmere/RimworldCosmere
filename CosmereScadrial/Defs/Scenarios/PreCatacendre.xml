        <!-- Sits after ScenPart_NamedPawns on purpose. That part clears the roster
             and this one regenerates it, with NamedPawns stamping its templates onto
             each pawn through Notify_PawnGenerated as it comes out. -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>10</pawnChoiceCount>
          <!-- TotalPawnCount is the sum of these, and it is what sets
               startingPawnCount. An empty list means zero starting pawns and an
               index error during map generation. No xenotype named, so the named
               pawns decide their own. -->
          <xenotypeCounts>
            <li>
              <count>10</count>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

