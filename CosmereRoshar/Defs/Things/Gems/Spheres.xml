<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef Name="Cosmere_Roshar_Thing_Sphere" ParentName="Cosmere_Roshar_Thing_CurrencyBase" Abstract="True">
        <thingCategories>
            <li>Cosmere_Roshar_ThingCategory_Sphere</li>
        </thingCategories>

        <graphicData>
            <graphicClass>Cosmere.Core.Graphic.GemStuff</graphicClass>
            <drawSize>.5</drawSize>
        </graphicData>

        <stuffCategories>
            <li>Cosmere_Core_StuffCategory_CutGems</li>
        </stuffCategories>
        <costList>
            <Cosmere_Core_Thing_Glass>1</Cosmere_Core_Thing_Glass>
        </costList>

        <recipeMaker>
            <useIngredientsForColor>true</useIngredientsForColor>
            <workAmount>1600</workAmount>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <effectWorking>CutStone</effectWorking>
            <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
            <workSkill>Crafting</workSkill> <!-- custom skill? -->
            <researchPrerequisites>
                <li>Cosmere_Gem_Cutting</li>
                <li>Cosmere_Roshar_SphereProduction</li>
            </researchPrerequisites>
            <recipeUsers>
                <li>Cosmere_Core_Table_GemCutter</li>
            </recipeUsers>
        </recipeMaker>
        <comps>
            <li Class="Cosmere.System.Roshar.Comp.Thing.SphereGlowerProperties"/>
        </comps>
    </ThingDef>

    <!-- Chip - Smallest denomination -->
    <ThingDef ParentName="Cosmere_Roshar_Thing_Sphere">
        <defName>Cosmere_Roshar_Thing_Chip</defName>
        <label>chip</label>
        <description>A small glass sphere with a tiny gemstone chip at its center. Chips are the smallest denomination of Rosharan currency, used for everyday purchases. Even infused, they hold only a trace of Stormlight.</description>

        <graphicData>
            <texPath>Item/Resource/Sphere/Chip</texPath>
            <drawSize>.35</drawSize>
        </graphicData>

        <statBases>
            <Mass>0.00005</Mass>
            <Beauty>.02</Beauty>
            <MarketValue>1</MarketValue>
        </statBases>

        <costStuffCount>1</costStuffCount>

        <recipeMaker>
            <label>chip</label>
            <productCount>5</productCount>
            <displayPriority>1</displayPriority>
            <workSkill>Crafting</workSkill>
        </recipeMaker>

        <comps>
            <li Class="Cosmere.Core.Comp.Thing.InvestitureHolderProperties">
                <maxInvestiture>5</maxInvestiture>
                <drainRate>0.005</drainRate>
            </li>
        </comps>
    </ThingDef>

    <!-- Mark - Medium denomination -->
    <ThingDef ParentName="Cosmere_Roshar_Thing_Sphere">
        <defName>Cosmere_Roshar_Thing_Mark</defName>
        <label>mark</label>
        <description>A polished glass sphere with a gemstone set at its heart. Marks serve as currency across Roshar and hold Stormlight when infused, glowing with the color of their gem. Diamond marks are the most common denomination.</description>

        <graphicData>
            <texPath>Item/Resource/Sphere/Mark</texPath>
        </graphicData>

        <statBases>
            <Mass>0.0001</Mass>
            <Beauty>.05</Beauty>
            <MarketValue>5</MarketValue>
        </statBases>

        <costStuffCount>1</costStuffCount>

        <recipeMaker>
            <label>mark</label>
            <productCount>1</productCount>
            <displayPriority>2</displayPriority>
            <workSkill>Crafting</workSkill>
        </recipeMaker>

        <comps>
            <li Class="Cosmere.Core.Comp.Thing.InvestitureHolderProperties">
                <maxInvestiture>24</maxInvestiture>
                <drainRate>0.005</drainRate>
            </li>
        </comps>
    </ThingDef>

    <!-- Broam - Largest denomination -->
    <ThingDef ParentName="Cosmere_Roshar_Thing_Sphere">
        <defName>Cosmere_Roshar_Thing_Broam</defName>
        <label>broam</label>
        <description>A large, perfectly spherical glass orb containing a sizable gemstone. Broams are the largest standard denomination of Rosharan currency, worth twenty marks. When infused, they glow brilliantly with Stormlight.</description>

        <graphicData>
            <texPath>Item/Resource/Sphere/Broam</texPath>
            <drawSize>.65</drawSize>
        </graphicData>

        <statBases>
            <Mass>0.0003</Mass>
            <Beauty>.15</Beauty>
            <MarketValue>100</MarketValue>
        </statBases>

        <costStuffCount>2</costStuffCount>

        <recipeMaker>
            <label>broam</label>
            <productCount>1</productCount>
            <displayPriority>3</displayPriority>
            <workSkill>Crafting</workSkill>
        </recipeMaker>

        <comps>
            <li Class="Cosmere.Core.Comp.Thing.InvestitureHolderProperties">
                <maxInvestiture>120</maxInvestiture>
                <drainRate>0.005</drainRate>
            </li>
        </comps>
    </ThingDef>

</Defs>