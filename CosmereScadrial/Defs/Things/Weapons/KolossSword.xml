<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A koloss carries an enormous crude sword it took off a dead koloss, and gets a bigger one
       the same way. Nobody forges these to a pattern - they are beaten out of whatever was to
       hand and passed along by inheritance, which is why they are heavy, blunt-edged and far too
       large for a person to swing properly.

       Its own weaponTag matters twice over: it keeps koloss out of the industrial weapon pools
       every other faction draws from, and it means the sword drops when the koloss does. -->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp">
    <defName>Cosmere_Scadrial_Thing_KolossSword</defName>
    <label>koloss blade</label>
    <description>A length of industrial saw plate, torn off whatever it used to turn in and wrapped at one end for a grip. The teeth are still on it. Nothing about it was made for this, and nothing about it was made for a hand smaller than the one carrying it now.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/KolossSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- Vanilla weapons sit in a 64x64 square and take the default 1.0, but their blades are
           about one to four. This one is one to eight, so at the same canvas it reads half the
           height and looks like a toy. Drawn larger than a tile, which a koloss weapon should be
           regardless - it is meant to be too big for a person. -->
      <drawSize>1.7</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>Cosmere_Scadrial_KolossWeapon</li>
    </weaponTags>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <!-- Not craftable and not traded. Every one of these came off a dead koloss, which is also
         the only way a player gets one. -->
    <tradeability>None</tradeability>
    <!-- The art is greyscale, so the game tints it by material the way it does every other melee
         weapon. A koloss sword is whatever somebody beat it out of. -->
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>140</costStuffCount>
    <statBases>
      <Mass>7</Mass>
      <MarketValue>90</MarketValue>
    </statBases>
    <equippedAngleOffset>-55</equippedAngleOffset>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.4</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>28</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>flat</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>22</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>
