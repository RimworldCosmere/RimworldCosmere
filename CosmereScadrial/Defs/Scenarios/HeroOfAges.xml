                <li><def>Tough</def><degree>0</degree></li>
              </traits>
              <skills>
                <li><def>Cosmere_Scadrial_Skill_AllomanticPower</def><level>1</level><passion>Major</passion></li>
                <li><def>Melee</def><level>18</level></li>
                <li><def>Shooting</def><level>12</level></li>
              </skills>
            </li>
            <li>
