<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SitePartDef>
    <defName>Cosmere_Scadrial_SitePart_AtiumField</defName>
    <label>atium crystal field</label>
    <description>Crystal faces break the ground across the whole basin, not in one seam but in dozens. This is what a thousand years of forced digging looks like from above.</description>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/PreciousLump</expandingIconTexture>
    <tags>
      <li>Cosmere_AtiumField</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>Cosmere_Scadrial_GenStep_AtiumField</defName>
    <linkWithSite>Cosmere_Scadrial_SitePart_AtiumField</linkWithSite>
    <!-- Before PreciousLump's 900, so its ScatterAt still has the last word on RectOfInterest
         and the garrison anchors on the main seam rather than an outlying vein. -->
    <order>880</order>
    <genStep Class="Cosmere.Core.Quest.GenStep_ScatterCrystalVeins">
      <forcedDefToScatter>MineableAtium</forcedDefToScatter>
      <!-- One origin, not ten. Every branch grows from its parent's tip, so the whole thing is
           one connected crystal; it only breaks where a branch runs into non-rock.
           branchLength sets how far the mass sprawls - five generations of 11 plus the trunk
           radius puts the outer edge at most 60 cells out, which on a 200-cell map leaves a
           39-cell band for the Ministry to wall its 33-cell fort into. Push it past 12 and
           GenStep_Outpost runs out of room beside the ore and drops the fort on top of it. -->
      <count>1</count>
      <forcedLumpSize>3570</forcedLumpSize>
      <trunkRadius>5</trunkRadius>
      <branchLength>11</branchLength>
      <maxDepth>4</maxDepth>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>Cosmere_Scadrial_GenStep_AtiumOnly</defName>
    <linkWithSite>Cosmere_Scadrial_SitePart_AtiumField</linkWithSite>
    <!-- After every scatter step, including PreciousLump at 900 and the dendrites at 880, so
         it sweeps up whatever the base generator seeded the rock with. -->
    <order>970</order>
    <genStep Class="Cosmere.Core.Quest.GenStep_ClearOtherOres">
      <keep>MineableAtium</keep>
    </genStep>
  </GenStepDef>

</Defs>
