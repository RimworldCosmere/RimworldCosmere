<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <thingClass>Cosmere.Framework.Thing.ApparelWithStorage</thingClass>
    <defName>Cosmere_Roshar_Apparel_SpherePouch</defName>
    <label>sphere pouch</label>
    <description>A leather pouch used to carry infused spheres, allowing Radiants to easily draw Stormlight.</description>
    <graphicData>
      <texPath>Things/Apparel/SpherePouch</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Normal</tickerType>
    <techLevel>Animal</techLevel>
    <statBases>
      <Mass>3</Mass>
      <WorkToMake>14000</WorkToMake>
      <Flammability>0.4</Flammability>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
      <displayPriority>210</displayPriority>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
    <costStuffCount>70</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>BeltDefense</li>
      </tags>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </apparel>
    <inspectorTabs>
      <li>Cosmere.Framework.InspectorTab.ApparelStorage</li>
    </inspectorTabs>
    <comps>
      <li Class="Cosmere.Framework.Comp.Thing.ApparelStorageProperties">
        <defaultStorageSettings>
          <filter>
            <allowedHitPointsConfigurable>false</allowedHitPointsConfigurable>
            <categories>
              <li>Cosmere_Roshar_ThingCategory_Sphere</li>
            </categories>
          </filter>
        </defaultStorageSettings>
        <fixedStorageSettings>
          <filter>
            <allowedHitPointsConfigurable>false</allowedHitPointsConfigurable>
            <categories>
              <li>Cosmere_Roshar_ThingCategory_Sphere</li>
            </categories>
          </filter>
        </fixedStorageSettings>
      </li>
      <li Class="Cosmere.Roshar.Comp.Thing.SpherePouchProperties">
        <maxCapacity>100</maxCapacity>
        <allowedSpheres>
          <li>Cosmere_Roshar_Thing_Chip</li>
          <li>Cosmere_Roshar_Thing_Mark</li>
          <li>Cosmere_Roshar_Thing_Broam</li>
        </allowedSpheres>
      </li>
      <li Class="Cosmere.Core.Comp.Thing.InvestitureHolderProperties" />
    </comps>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
  </ThingDef>
</Defs>
