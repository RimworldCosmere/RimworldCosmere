<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>Cosmere_Scadrial_Item_AtiumGeode</defName>
        <label>atium geode</label>
        <description>A knot of pale crystal broken free of the Pits of Hathsin. The geode itself is worth little. Roughly one in twelve holds a bead of atium at its centre, and that is why the Lord Ruler keeps the Pits.</description>

        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.85</drawSize>
            <texPath>Item/Resource/Atium</texPath>
            <color>(207, 226, 235)</color>
        </graphicData>

        <soundInteract>Standard_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>
        <useHitPoints>false</useHitPoints>
        <healthAffectsPrice>false</healthAffectsPrice>

        <statBases>
            <MaxHitPoints>60</MaxHitPoints>
            <MarketValue>25</MarketValue>
            <Mass>0.3</Mass>
            <Flammability>0</Flammability>
        </statBases>

        <thingCategories>
            <li>ResourcesRaw</li>
        </thingCategories>
    </ThingDef>

    <ThingDef ParentName="RockBase">
        <defName>MineableAtium</defName>
        <label>atium geode seam</label>
        <description>Crystal grown through dark stone, the way it does only in the Pits of Hathsin. Cutting it free yields geodes. The geodes must be cracked open to learn which of them are hollow.</description>

        <graphicData>
            <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <color>(207, 226, 235)</color>
            <colorTwo>(38, 34, 45)</colorTwo>
        </graphicData>

        <statBases>
            <MaxHitPoints>1600</MaxHitPoints>
        </statBases>

        <building>
            <isResourceRock>true</isResourceRock>
            <veinMineable>true</veinMineable>
            <mineableThing>Cosmere_Scadrial_Item_AtiumGeode</mineableThing>
            <mineableYield>1</mineableYield>
            <!-- ~60-tile lump, so about a third yielding lands near the 20 the quest asks for. -->
            <mineableDropChance>0.35</mineableDropChance>
            <!-- Zero so it never scatters in ordinary world gen. The Pits quest places it. -->
            <mineableScatterCommonality>0</mineableScatterCommonality>
        </building>
    </ThingDef>
</Defs>
