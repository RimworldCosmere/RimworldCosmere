            </li>
          </pawns>
        </li>

        <!-- Sits after ScenPart_NamedPawns on purpose. That part clears the roster
             and this one regenerates it, with NamedPawns stamping its templates onto
             each pawn through Notify_PawnGenerated as it comes out. -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>10</pawnChoiceCount>
          <!-- TotalPawnCount is the sum of these, and it is what sets
               startingPawnCount. An empty list means zero starting pawns and an
               index error during map generation. No xenotype named, so the named
               pawns decide their own. -->
          <xenotypeCounts>
            <li>
              <count>10</count>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSimple</thingDef>
          <count>100</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>40</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>20</count>
        </li>

        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>600</count>
        </li>

        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>400</count>
        </li>

        <li Class="Cosmere.Core.ScenarioPart.Parts.ScenPart_ScenarioProgression">
          <def>Cosmere_ScenPart_ScenarioProgression</def>
          <progression>Cosmere_Scadrial_Progression_WellOfAscension</progression>
        </li>

        <li Class="Cosmere.Core.ScenarioPart.Parts.ScenPart_FactionRelations">
          <def>Cosmere_ScenPart_FactionRelations</def>
          <relations>
            <Cosmere_Scadrial_Faction_Terris>60</Cosmere_Scadrial_Faction_Terris>
            <Cosmere_Scadrial_Faction_SkaaRebels>40</Cosmere_Scadrial_Faction_SkaaRebels>
            <Cosmere_Scadrial_Faction_HouseVenture>-80</Cosmere_Scadrial_Faction_HouseVenture>
            <Cosmere_Scadrial_Faction_HouseElariel>-80</Cosmere_Scadrial_Faction_HouseElariel>
            <Cosmere_Scadrial_Faction_HouseHasting>-80</Cosmere_Scadrial_Faction_HouseHasting>
            <Cosmere_Scadrial_Faction_HouseLekal>-80</Cosmere_Scadrial_Faction_HouseLekal>
            <Cosmere_Scadrial_Faction_HouseTekiel>-80</Cosmere_Scadrial_Faction_HouseTekiel>
            <Cosmere_Scadrial_Faction_HouseRenoux>-80</Cosmere_Scadrial_Faction_HouseRenoux>
            <Cosmere_Scadrial_Faction_HouseCett>-80</Cosmere_Scadrial_Faction_HouseCett>
            <Cosmere_Scadrial_Faction_FinalEmpireNPC>-100</Cosmere_Scadrial_Faction_FinalEmpireNPC>
          </relations>
        <between>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_FinalEmpireNPC</b>
            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_HouseCett</b>
            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_HouseElariel</b>
            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_HouseHasting</b>
            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_HouseLekal</b>
            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
            <b>Cosmere_Scadrial_Faction_HouseRenoux</b>
            <goodwill>-100</goodwill>
          </li>
          <li>
            <a>Cosmere_Scadrial_Faction_SkaaRebels</a>
