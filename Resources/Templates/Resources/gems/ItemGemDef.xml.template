<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- One stuff category per gem, for the same reason the metals have one: a recipe can only
         narrow by stuff category, so without this there is no way to ask for a specific gem. -->
    <StuffCategoryDef>
        <defName>Cosmere_Core_StuffCategory_Gem_{{defName gem.name}}</defName>
        <label>{{title gem.name}}</label>
        <noun>{{title gem.name}}</noun>
        <destroySoundSmall>BuildingDestroyed_Metal_Small</destroySoundSmall>
        <destroySoundMedium>BuildingDestroyed_Metal_Medium</destroySoundMedium>
        <destroySoundLarge>BuildingDestroyed_Metal_Large</destroySoundLarge>
    </StuffCategoryDef>

    <!-- Raw {{defName gem.name}} -->
    <ThingDef ParentName="CosmereGemBase">
        <defName>Raw{{defName gem.name}}</defName>
        <label>{{title gem.name}}</label>
        <description>{{gem.descriptions.raw}}</description>

        <thingCategories>
            <li>Cosmere_Core_ThingCategory_RawGem</li>
        </thingCategories>

        <graphicData>
            {{# unless gem.stackable}}
            <graphicClass>Graphic_Single</graphicClass>
            {{/unless}}
            <drawSize>{{gem.drawSize}}</drawSize>
            <texPath>Item/Resource/Gems/Uncut/{{defName gem.name}}</texPath>
        </graphicData>

        <statBases>
            <Mass>0.0006</Mass>
            <Beauty>{{gem.baseBeauty}}</Beauty>
            <MarketValue>{{gem.baseMarketValue}}</MarketValue>
        </statBases>


        <stuffProps>
            <categories>
                <li>Cosmere_Core_StuffCategory_Gem_{{defName gem.name}}</li>
                <li>Cosmere_Core_StuffCategory_Gems</li>
                <li>Cosmere_Core_StuffCategory_RawGems</li>
            </categories>
        </stuffProps>

        <modExtensions>
            <li Class="Cosmere.Core.DefModExtension.GemsLinked">
                <gem>{{defName gem.name}}</gem>
            </li>
        </modExtensions>
        <comps>
            <li MayRequire="Cosmere.Roshar" Class="Cosmere.Core.Comp.Thing.InvestitureHolderProperties">
                <maxInvestiture>{{gem.baseStormlight}}</maxInvestiture>
                <startingInvestiture>0</startingInvestiture>
                <drainRate>0.5</drainRate>
            </li>
        </comps>
    </ThingDef>
</Defs>