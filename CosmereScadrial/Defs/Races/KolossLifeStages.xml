<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- One per growth stage. A koloss is drawn from a mesh this size rather than a person-sized
       mesh scaled up, because past a camera zoom of 18 RimWorld stops drawing humanlikes at all
       and blits a picture baked into a shared atlas - and that tile is cut for a person. A scaled
       transform lost its legs the moment the player zoomed out, and only then.

       bodyWidth is what HumanlikeMeshPoolUtility reads, so it decides the tile. bodySizeFactor is
       what Pawn.BodySize reads, so it decides carried mass, hunger and how much cover it needs.
       Both climb together because they are the same fact about the thing.

       Four bands rather than a smooth curve is the cost of this approach: bodyWidth is a def
       field, so size steps rather than creeps. The steps line up with the growth hediff's stages,
       which is where the player already sees it change. -->

  <!-- Copied from HumanlikeAdult rather than inheriting it, because it is a concrete def with no
       abstract parent. developmentalStage Adult is load-bearing: a koloss that reads as anything
       else loses adult apparel, adult work and adult social interactions. -->
  <LifeStageDef Name="Cosmere_Scadrial_KolossLifeStageBase" Abstract="True">
    <workerClass MayRequire="Ludeon.RimWorld.Biotech">LifeStageWorker_HumanlikeAdult</workerClass>
    <developmentalStage>Adult</developmentalStage>
    <visible>false</visible>
    <reproductive>false</reproductive>
    <sittingOffset>0.18</sittingOffset>
    <voxPitch>0.8</voxPitch>
    <silhouetteGraphicData>
      <texPath>Things/Pawn/Humanlike/Silhouettes/Silhouette_HumanAdult</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </silhouetteGraphicData>
  </LifeStageDef>

  <LifeStageDef ParentName="Cosmere_Scadrial_KolossLifeStageBase">
    <defName>Cosmere_Scadrial_LifeStage_KolossYoung</defName>
    <label>koloss</label>
    <bodyWidth>1.6</bodyWidth>
    <bodySizeFactor>1.05</bodySizeFactor>
    <healthScaleFactor>1.05</healthScaleFactor>
  </LifeStageDef>

  <LifeStageDef ParentName="Cosmere_Scadrial_KolossLifeStageBase">
    <defName>Cosmere_Scadrial_LifeStage_KolossGrown</defName>
    <label>koloss</label>
    <bodyWidth>2.0</bodyWidth>
    <bodySizeFactor>1.30</bodySizeFactor>
    <healthScaleFactor>1.30</healthScaleFactor>
  </LifeStageDef>

  <LifeStageDef ParentName="Cosmere_Scadrial_KolossLifeStageBase">
    <defName>Cosmere_Scadrial_LifeStage_KolossOvergrown</defName>
    <label>koloss</label>
    <bodyWidth>2.3</bodyWidth>
    <bodySizeFactor>1.55</bodySizeFactor>
    <healthScaleFactor>1.55</healthScaleFactor>
  </LifeStageDef>

  <LifeStageDef ParentName="Cosmere_Scadrial_KolossLifeStageBase">
    <defName>Cosmere_Scadrial_LifeStage_KolossSplitting</defName>
    <label>koloss</label>
    <bodyWidth>2.6</bodyWidth>
    <bodySizeFactor>1.75</bodySizeFactor>
    <healthScaleFactor>1.75</healthScaleFactor>
  </LifeStageDef>

</Defs>
