<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BuildingNaturalBase">
        <defName>Cosmere_Scadrial_Thing_AshVent</defName>
        <label>ash vent</label>
        <description>A crack in the rock where the mountain breathes out. The Ashmounts themselves are a long way off, but the ground between here and there is not solid, and what they push up finds its way to the surface wherever it can. The stone around the opening is warm to the touch and the air above it will not hold still.</description>
        <thingClass>Building</thingClass>
        <graphicData>
            <texPath>Things/Building/Natural/AshVent</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>Transparent</shaderType>
            <drawSize>(4,4)</drawSize>
        </graphicData>
        <uiIconScale>0.5</uiIconScale>
        <altitudeLayer>Floor</altitudeLayer>
        <rotatable>false</rotatable>
        <destroyable>false</destroyable>
        <useHitPoints>false</useHitPoints>
        <tickerType>Normal</tickerType>
        <size>(2,2)</size>
        <neverOverlapFloors>true</neverOverlapFloors>
        <blockPlants>true</blockPlants>
        <building>
            <isEdifice>false</isEdifice>
            <claimable>false</claimable>
            <deconstructible>false</deconstructible>
        </building>
        <comps>
            <li Class="Cosmere.System.Scadrial.Comp.Thing.CompProperties_AshVent">
                <millimetresPerDay>140</millimetresPerDay>
                <skew>0.55</skew>
            </li>
        </comps>
    </ThingDef>

</Defs>
