<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <PawnKindDef>
        <defName>Cosmere_Roshar_PawnKind_Lighteyes</defName>
        <!-- Names its own people, so the faction's set must not be added on top: chances are
         summed, and a Skaa kind in a noble house came out Noble half the time. This is
         what lets a great house keep skaa without its lords becoming skaa. -->
        <useFactionXenotypes>false</useFactionXenotypes>
        <label>rosharan lighteyes</label>
        <race>Human</race>
        <xenotypeSet>
            <xenotypeChances>
                <Cosmere_Roshar_Xenotype_Lighteyes>1</Cosmere_Roshar_Xenotype_Lighteyes>
            </xenotypeChances>
        </xenotypeSet>
        <combatPower>45</combatPower>
        <gearHealthRange>
            <min>0.3</min>
            <max>0.9</max>
        </gearHealthRange>
        <initialResistanceRange>
            <min>0.3</min>
            <max>0.9</max>
        </initialResistanceRange>
        <initialWillRange>
            <min>0.3</min>
            <max>0.9</max>
        </initialWillRange>
        <inventoryOptions>
            <skipChance>1</skipChance>
        </inventoryOptions>
    </PawnKindDef>

