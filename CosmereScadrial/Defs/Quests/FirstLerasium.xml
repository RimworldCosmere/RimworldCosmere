<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <Cosmere.Core.Quest.CosmereQuestDef>
        <defName>Cosmere_Scadrial_Quest_FirstLerasium</defName>
        <label>The First Bead</label>
        <description>Lerasium is not found. It was made once, by a man who became a god, and what remains of it sits in vaults the Ministry does not admit exist. One bead. The obligator who told you this did not live long enough to regret it.</description>

        <kind>Capstone</kind>
        <subject>Colony</subject>
        <eras>
            <li>Cosmere_Scadrial_Era_PreCatacendre</li>
        </eras>

        <giverFaction>Cosmere_Scadrial_Faction_SkaaRebels</giverFaction>
        <targetFaction>Cosmere_Scadrial_Faction_FinalEmpireNPC</targetFaction>

        <expireAfterDays>20</expireAfterDays>
        <cooldownDays>15</cooldownDays>
        <challengeRating>5</challengeRating>
        <minColonists>5</minColonists>
        <minDaysElapsed>70</minDaysElapsed>

        <stages>
            <li>
                <key>infiltrate</key>
                <objective Class="Cosmere.Core.Quest.Objective.TravelToSiteObjective">
                    <sitePart>Outpost</sitePart>
                    <minTiles>8</minTiles>
                    <maxTiles>18</maxTiles>
                    <threatPoints>900</threatPoints>
                </objective>
            </li>
            <li>
                <key>breach</key>
                <objective Class="Cosmere.Core.Quest.Objective.ClearSiteObjective" />
            </li>
            <li>
                <key>recover</key>
                <objective Class="Cosmere.Core.Quest.Objective.SpawnThingObjective">
                    <thingDef>Lerasium</thingDef>
                    <count>1</count>
                </objective>
            </li>
            <li>
                <key>carry</key>
                <objective Class="Cosmere.Core.Quest.Objective.CarryHomeObjective">
                    <thingDef>Lerasium</thingDef>
                    <count>1</count>
                </objective>
            </li>
        </stages>

        <rewards>
            <li Class="Cosmere.System.Scadrial.Quest.LerasiumChoiceReward" />
        </rewards>

        <onFailure Class="Cosmere.Core.Quest.Outcome.BurnCapstone" />
    </Cosmere.Core.Quest.CosmereQuestDef>
</Defs>
