<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>Cosmere_Scadrial_Scenario_LostMetal</defName>
    <label>Cosmere - Scadrial - The Lost Metal</label>
    <description>Six years on. The Set have stopped hiding, because they are far enough along that being seen no longer costs them anything, and they were never working for themselves. There is something behind them that has never set foot on Scadrial and does not intend to.</description>
    <scenario>
      <summary>The Set stop hiding, and Harmony goes quiet about why.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>Cosmere_Scadrial_Faction_HouseLadrian</factionDef>
      </playerFaction>
      <parts>
        <li Class="Cosmere.Core.ScenarioPart.Parts.ScenPart_NamedPawns">
          <def>Cosmere_ScenPart_NamedPawns</def>
          <pawns>
