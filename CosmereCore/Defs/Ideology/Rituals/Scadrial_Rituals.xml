<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- ========== SCADRIAL RITUALS ========== -->

    <!-- ===== STEEL MINISTRY ===== -->

    <!-- Execution Rite: Sacrifice a prisoner to honor the Lord Ruler -->
    <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_Ritual_ExecutionRite</defName>
        <label>execution rite</label>
        <description>A ritualistic execution where an Obligator oversees the death of a prisoner or criminal. The assembled faithful watch as divine justice is carried out in the name of the Lord Ruler.</description>
        <issue>Ritual</issue>
        <impact>High</impact>
        <iconPath>UI/Ideology/Cosmere/SteelMinistry</iconPath>
        <preceptClass>Precept_Ritual</preceptClass>
        <ritualPatternBase>SacrificePrisoner</ritualPatternBase>
        <allowDuplicates>false</allowDuplicates>
        <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
        <selectionWeight>1.0</selectionWeight>
        <displayOrderInImpact>100</displayOrderInImpact>
        <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
        <requiredMemes>
            <li>Cosmere_Structure_SteelMinistry</li>
        </requiredMemes>
    </PreceptDef>

    <!-- Steel Ministry Festival: Celebration of the Lord Ruler's ascension -->
    <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_Ritual_AscensionDay</defName>
        <label>ascension day</label>
        <description>A solemn festival commemorating the day the Lord Ruler took up the power at the Well of Ascension. Faithful gather to hear speeches about his eternal wisdom and the proper order of things.</description>
        <issue>Ritual</issue>
        <impact>Medium</impact>
        <iconPath>UI/Ideology/Cosmere/SteelMinistry</iconPath>
        <preceptClass>Precept_Ritual</preceptClass>
        <ritualPatternBase>CelebrationPartyChat</ritualPatternBase>
        <allowDuplicates>false</allowDuplicates>
        <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
        <selectionWeight>1.0</selectionWeight>
        <displayOrderInImpact>100</displayOrderInImpact>
        <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
        <allowOptionalRitualObligations>true</allowOptionalRitualObligations>
        <requiredMemes>
            <li>Cosmere_Structure_SteelMinistry</li>
        </requiredMemes>
    </PreceptDef>

    <!-- ===== CHURCH OF THE SURVIVOR ===== -->

    <!-- Liberation Day: Celebrating Kelsier's rebellion -->
    <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_Ritual_LiberationDay</defName>
        <label>liberation day</label>
        <description>A joyous celebration of freedom and defiance. The faithful gather to share stories of the Survivor's rebellion, to remember those who fell fighting oppression, and to renew their commitment to helping the downtrodden.</description>
        <issue>Ritual</issue>
        <impact>Medium</impact>
        <iconPath>UI/Ideology/Cosmere/ChurchOfSurvivor</iconPath>
        <preceptClass>Precept_Ritual</preceptClass>
        <ritualPatternBase>CelebrationPartyChat</ritualPatternBase>
        <allowDuplicates>false</allowDuplicates>
        <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
        <selectionWeight>1.0</selectionWeight>
        <displayOrderInImpact>100</displayOrderInImpact>
        <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
        <allowOptionalRitualObligations>true</allowOptionalRitualObligations>
        <requiredMemes>
            <li>Cosmere_Structure_ChurchOfSurvivor</li>
        </requiredMemes>
    </PreceptDef>

    <!-- Survivor's Vigil: Honoring the dead who fought for freedom -->
    <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_Ritual_SurvivorsVigil</defName>
        <label>survivor's vigil</label>
        <description>A quiet gathering where the faithful light candles and share memories of those who died fighting for freedom. The Survivor watches over all who resist oppression.</description>
        <issue>Ritual</issue>
        <impact>Low</impact>
        <iconPath>UI/Ideology/Cosmere/ChurchOfSurvivor</iconPath>
        <preceptClass>Precept_Ritual</preceptClass>
        <ritualPatternBase>CelebrationSkyLanterns</ritualPatternBase>
        <allowDuplicates>false</allowDuplicates>
        <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
        <selectionWeight>1.0</selectionWeight>
        <displayOrderInImpact>100</displayOrderInImpact>
        <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
        <associatedMemes>
            <li>Cosmere_Structure_ChurchOfSurvivor</li>
            <li>Cosmere_Structure_Survivorism</li>
        </associatedMemes>
    </PreceptDef>

    <!-- ===== SURVIVORISM ===== -->

    <!-- Defiance Gathering: Rallying against oppression -->
