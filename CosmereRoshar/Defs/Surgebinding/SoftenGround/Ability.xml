<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <Cosmere.System.Roshar.Def.SurgebindingAbilityDef ParentName="Cosmere_Roshar_Ability_TargetCastAbility">
        <defName>Cosmere_Roshar_Ability_SoftenGround</defName>
        <label>Soften Ground</label>
        <description>Reach into the ground with the Surge of Cohesion and loosen its bonds. Stone becomes clay. Packed earth turns to mud. Enemies crossing the area feel the ground give way beneath every step, their feet sinking into soil that was solid a moment ago. They struggle and slow, mired in terrain that no longer supports them.</description>
        <abilityClass>Cosmere.System.Roshar.Surgebinding.Ability.Cohesion.SoftenGround</abilityClass>
        <hediff>Cosmere_Roshar_Hediff_SoftenedGround</hediff>
        <beuPerTick>12</beuPerTick>
        <maxPower>1</maxPower>
        <cooldownTicksRange>300~300</cooldownTicksRange>
        <minIdeal>2</minIdeal>
        <hostile>true</hostile>
        <verbProperties>
            <targetable>true</targetable>
            <warmupTime>0</warmupTime>
            <range>18</range>
            <requireLineOfSight>true</requireLineOfSight>
            <violent>false</violent>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>
        </verbProperties>
    </Cosmere.System.Roshar.Def.SurgebindingAbilityDef>
</Defs>
