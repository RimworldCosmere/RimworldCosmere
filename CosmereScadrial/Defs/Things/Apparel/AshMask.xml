<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ThingDef ParentName="HatMakeableBase">
        <defName>Cosmere_Scadrial_Apparel_AshMask</defName>
        <label>ash mask</label>
        <description>Layered cloth over a wooden frame, tied behind the head and packed with charcoal. Skaa who work the ashmounts have made them the same way for generations. It does not filter everything, and it does nothing at all about the heat, but a worker wearing one can stand at a vent long enough to finish the job.</description>
        <techLevel>Neolithic</techLevel>
        <tradeability>Sellable</tradeability>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Pawn/Humanlike/Apparel/AshMask/AshMask</texPath>
            <drawSize>0.8</drawSize>
        </graphicData>
        <costStuffCount>30</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToMake>2400</WorkToMake>
            <Mass>0.3</Mass>
            <EquipDelay>0.8</EquipDelay>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
        </statBases>
        <equippedStatOffsets>
            <!-- Break-even is filtration 0.769 - above that a masked pawn heals at the mouth.
                 0.6 slows ash lung without stopping it. Biotech's gas mask gets 1.0 by patch. -->
            <Cosmere_Scadrial_Stat_AshFiltration>0.6</Cosmere_Scadrial_Stat_AshFiltration>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>FullHead</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AshMask/AshMask</wornGraphicPath>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <layers>
                <li>Overhead</li>
            </layers>
            <!-- Same reasoning as the mistcloak: a generic tag puts this in the pool every pawn
                 rolls from at generation, and the Final Empire does not need every skaa masked. -->
            <tags>
                <li>Cosmere_Scadrial_AshMask</li>
            </tags>
            <defaultOutfitTags>
                <li>Worker</li>
            </defaultOutfitTags>
            <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
            <forceEyesVisibleForRotations>
                <li>1</li>
                <li>2</li>
                <li>3</li>
            </forceEyesVisibleForRotations>
        </apparel>
        <comps>
            <li Class="Cosmere.System.Scadrial.Comp.Thing.CompProperties_AshMask">
                <scoreOffsetNearVents>0.5</scoreOffsetNearVents>
            </li>
        </comps>
        <tradeTags>
            <li>BasicClothing</li>
        </tradeTags>
        <recipeMaker>
            <!-- HatMakeableBase carries no research gate, so there is nothing to clear. The
                 Final Empire has no machining table and this must stay buildable without one. -->
            <displayPriority>105</displayPriority>
        </recipeMaker>
        <colorGenerator Class="ColorGenerator_StandardApparel" />
    </ThingDef>
</Defs>
