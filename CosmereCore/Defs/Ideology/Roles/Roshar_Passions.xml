<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Passion Speaker: single leader, orator of the Thaylen faith -->
    <PreceptDef ParentName="PreceptRoleSingleBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_PassionSpeaker</defName>
        <label>passion speaker</label>
        <description>The leading voice of the Passions, charged with stirring the hearts of the faithful and binding a community through shared feeling. Their words carry the weight of a thousand burning souls.</description>
        <iconPath>UI/Roles/Leader</iconPath>
        <leaderRole>true</leaderRole>
        <impact>High</impact>
        <displayOrderInImpact>900</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <classicExtra>false</classicExtra>
        <canRemoveInUI>false</canRemoveInUI>
        <restrictToSupremeGenderChance>0</restrictToSupremeGenderChance>
        <convertPowerFactor>2</convertPowerFactor>
        <expectationsOffset>2</expectationsOffset>
        <requiredMemes>
            <li>Cosmere_Structure_Passions</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Social>5</Social>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.4</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>ConversionPower</statDef>
                <modifier>0.4</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>LeaderSpeech</li>
            <li>Convert</li>
            <li>Reassure</li>
        </grantedAbilities>
        <roleTags>
            <li>Leader</li>
            <li>Moralist</li>
        </roleTags>
    </PreceptDef>

    <!-- High Merchant: multi role, trader-priest -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_HighMerchant</defName>
        <label>high merchant</label>
        <description>A Thaylen trader-priest for whom commerce and devotion are one practice. The high merchant negotiates with the same fervor they bring to worship, and the Passions sanctify the deal.</description>
        <iconPath>UI/Roles/SpecialistProduction</iconPath>
        <nameMaker>NamerRoleProductionSpecialist</nameMaker>
        <impact>Medium</impact>
        <displayOrderInImpact>800</displayOrderInImpact>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <maxCount>5</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_Passions</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Social>5</Social>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>TradePriceImprovement</statDef>
                <modifier>0.25</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>NegotiationAbility</statDef>
                <modifier>0.3</modifier>
            </li>
        </roleEffects>
        <roleRequiredWorkTags>
            <li>Social</li>
        </roleRequiredWorkTags>
    </PreceptDef>

    <!-- Fervent: multi role, combat specialist fueled by passion -->
    <PreceptDef ParentName="PreceptRoleMultiBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_IdeoRole_Fervent</defName>
        <label>fervent</label>
        <description>A devotee who channels burning emotion into the blade. To fight with fervor is to worship, and no fever runs hotter than a Thaylen defending what they love.</description>
        <iconPath>UI/Roles/SpecialistMelee</iconPath>
        <nameMaker>NamerRoleBrawler</nameMaker>
        <impact>Medium</impact>
        <displayOrderInImpact>700</displayOrderInImpact>
        <defaultSelectionWeight>0.75</defaultSelectionWeight>
        <maxCount>4</maxCount>
        <requiredMemes>
            <li>Cosmere_Structure_Passions</li>
        </requiredMemes>
        <roleRequirements>
            <li Class="RoleRequirement_SameIdeo">
                <labelKey>RoleRequirementLabelSameIdeo</labelKey>
            </li>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Melee>6</Melee>
                    <Shooting>6</Shooting>
                </skills>
            </li>
        </roleRequirements>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>MeleeHitChance</statDef>
                <modifier>3</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>ShootingAccuracyPawn</statDef>
                <modifier>3</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>PainShockThreshold</statDef>
                <modifier>0.15</modifier>
            </li>
        </roleEffects>
        <grantedAbilities>
            <li>BerserkTrance</li>
        </grantedAbilities>
        <roleRequiredWorkTags>
            <li>Violent</li>
        </roleRequiredWorkTags>
    </PreceptDef>

</Defs>
