<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <Cosmere.Core.Quest.CosmereQuestDef>
        <defName>Cosmere_Scadrial_Quest_HathsinGeodeRun</defName>
        <label>Crystal in the Deep</label>
        <description>A survivor of the Pits of Hathsin has come to the colony, palms scarred through to bone from years spent breaking geodes free of the stone. He remembers a seam the Ministry never found, buried past where the obligators cared to dig. He has marked it on a map and asks nothing for it.\n\nHe was wrong about one thing. The Ministry found it, and left men on it.\n\nTake the seam, cut geodes from it, and bring at least twenty home. Stay as long or as little as you like - only what reaches the colony counts.\n\nMost geodes are hollow. The ones that are not give up their atium once the haul is sorted at the colony - at least one bead for every twenty carried back.</description>

        <kind>Repeatable</kind>
        <subject>Colony</subject>
        <eras>
            <li>Cosmere_Scadrial_Era_PreCatacendre</li>
        </eras>

        <targetFaction>Cosmere_Scadrial_Faction_FinalEmpireNPC</targetFaction>

        <selectionWeight>0.6</selectionWeight>
        <expireAfterDays>12</expireAfterDays>
        <cooldownDays>30</cooldownDays>
        <challengeRating>2</challengeRating>
        <minColonists>3</minColonists>

        <stages>
            <li>
                <key>travel</key>
                <descriptionKey>CS_Quest_Hathsin_Stage_Travel</descriptionKey>
                <objective Class="Cosmere.Core.Quest.Objective.TravelToSiteObjective">
                    <sitePart>PreciousLump</sitePart>
                    <extraSiteParts>
                        <li>Cosmere_Scadrial_SitePart_MinistryGarrison</li>
                    </extraSiteParts>
                    <preciousLumpResources>MineableAtium</preciousLumpResources>
                    <siteLabelKey>CS_Quest_Hathsin_Site</siteLabelKey>
                    <minTiles>10</minTiles>
                    <maxTiles>22</maxTiles>
                    <threatPoints>320</threatPoints>
                </objective>
            </li>
            <li>
                <key>carry</key>
                <descriptionKey>CS_Quest_Hathsin_Stage_Carry</descriptionKey>
                <objective Class="Cosmere.Core.Quest.Objective.CarryHomeObjective">
                    <thingDef>Cosmere_Scadrial_Item_AtiumGeode</thingDef>
                    <count>20</count>
                </objective>
            </li>
        </stages>

        <rewards>
            <li Class="Cosmere.System.Scadrial.Quest.GeodeConversionReward">
                <geodeDef>Cosmere_Scadrial_Item_AtiumGeode</geodeDef>
                <metalDef>Atium</metalDef>
                <chancePerGeode>0.08</chancePerGeode>
                <guaranteedPer>20</guaranteedPer>
            </li>
            <li Class="Cosmere.Core.Quest.Reward.FlagReward">
                <flag>HathsinLead</flag>
            </li>
        </rewards>

        <onFailure Class="Cosmere.Core.Quest.Outcome.NeverBurns" />
    </Cosmere.Core.Quest.CosmereQuestDef>
</Defs>
