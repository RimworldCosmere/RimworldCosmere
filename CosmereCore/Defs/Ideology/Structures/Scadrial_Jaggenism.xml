<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <MemeDef ParentName="Cosmere_StructureBase" MayRequire="Ludeon.RimWorld.Ideology">
        <defName>Cosmere_Structure_Jaggenism</defName>
        <label>Jaggenism</label>
        <description>He came from the north. He saved them all. The Sovereign emerged from the icy wastes bearing gifts of warmth and life. Jaggenism venerates the Sovereign who gave the Bands of Mourning to the people of the South.</description>
        <iconPath>UI/Ideology/Cosmere/Jaggenism</iconPath>
        <deityCount>1</deityCount>
        <worshipRoomLabel>sovereign hall</worshipRoomLabel>
        <generalRules>
            <rulesStrings>
                <li>r_ideoName(p=99)->[globalAdjective] [packIdeoName]</li>
                <li>r_ideoName(p=99)->[memeAdjective] [packIdeoName]</li>
                <li>r_ideoName(p=99)->[packAdjective] [packIdeoName]</li>
                <li>r_ideoName(p=99)->[packIdeoName]</li>
                <li>memeLeaderNoun->sovereign's voice</li>
                <li>memeLeaderNoun->high speaker</li>
                <li>memeLeaderNoun->keeper of bands</li>
                <li>memeLeaderAdjective->sovereign's</li>
                <li>memeLeaderAdjective->southern</li>
                <li>memeLeaderAdjective->blessed</li>
                <li>memeMoralist->speaker</li>
                <li>memeMoralist->elder</li>
                <li>memeMoralist->guide</li>
                <li>memeConcept->sovereign</li>
                <li>memeConcept->pilgrimage</li>
                <li>memeConcept->salvation</li>
                <li>memeHyphenPrefix->sovr</li>
                <li>memeHyphenPrefix->south</li>
                <li>memeHyphenPrefix->band</li>
            </rulesStrings>
        </generalRules>
        <descriptionMaker>
            <patterns>
                <li><def>TheistMyth</def></li>
                <li><def>TheistFounder</def></li>
            </patterns>
            <constants>
                <li><key>structure_theist</key><value>true</value></li>
                <li><key>structure_cosmere_jaggenism</key><value>true</value></li>
            </constants>
        </descriptionMaker>
        <fixedDeityNameTypes>
            <li>
                <name>The Sovereign</name>
                <type>savior from the north</type>
            </li>
            <li>
                <name>The Lord of the South</name>
                <type>giver of gifts</type>
            </li>
            <li>
                <name>He Who Gave the Bands</name>
                <type>the sovereign</type>
            </li>
            <li>
                <name>The Masked One</name>
                <type>bringer of warmth</type>
            </li>
        </fixedDeityNameTypes>
        <symbolPacks>
            <li>
                <ideoName>Jaggenism</ideoName>
                <adjective>Jaggenist</adjective>
                <member>Jaggenist</member>
                <prefix>true</prefix>
            </li>
            <li>
                <ideoName>Children of the Sovereign</ideoName>
                <adjective>sovereign's</adjective>
                <member>southerner</member>
                <prefix>true</prefix>
            </li>
            <li>
                <ideoName>Southern Faith</ideoName>
                <adjective>southern</adjective>
                <member>sovereign's child</member>
                <prefix>true</prefix>
            </li>
        </symbolPacks>
    </MemeDef>
</Defs>
