# =============================
# RimWorld Cosmere — .env.dist
# Copy to `.env` and customize.
# =============================

# ------------------------------
# Build configuration
# ------------------------------
# Debug or Release
CONFIG=Debug

# ------------------------------
# Game paths (absolute paths!)
# ------------------------------
# Path to your RimWorld install:
# - Windows (Steam default):   C:\Program Files (x86)\Steam\steamapps\common\RimWorld
# - macOS (Steam default):     /Applications/RimWorld.app/Contents
# - Linux (Steam default):     ~/.steam/steam/steamapps/common/RimWorld
RIMWORLD_DIR=C:\Program Files (x86)\Steam\steamapps\common\RimWorld

# Path to your RimWorld Mods folder:
# - Windows:  C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods
# - macOS:    ~/Library/Application\ Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Mods
# - Linux:    ~/.steam/steam/steamapps/common/RimWorld/Mods
MODS_DIR=C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods

# ------------------------------
# Unity asset building (optional)
# ------------------------------
# Path to Unity Editor executable (batch mode)
# Examples:
# - Windows:  C:\Program Files\Unity\Hub\Editor\2022.3.35f1\Editor\Unity.exe
# - macOS:    /Applications/Unity/Hub/Editor/2022.3.35f1/Unity.app/Contents/MacOS/Unity
# - Linux:    /home/user/Unity/Hub/Editor/2022.3.35f1/Editor/Unity
UNITY_PATH=C:\Program Files\Unity\Hub\Editor\2022.3.35f1\Editor\Unity.exe

# Path to Unity project for AssetBundles (if you use one)
UNITY_PROJECT=..\AssetBuilder
