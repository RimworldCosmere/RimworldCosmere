<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
    <name>Cosmere - Core</name>
    <description>The shared Investiture and Connection framework behind every Cosmere mod. On its own it adds the plumbing, not the powers. Install a Shardworld mod for those.</description>
    <authors>
        <li>CryptikLemur</li>
        <li>Luucid</li>
    </authors>
    <supportedVersions>
        <li>1.6</li>
    </supportedVersions>
    <packageId>Cosmere.Core</packageId>
    <modDependencies>
        <li>
            <packageId>Ludeon.RimWorld.Biotech</packageId>
            <displayName>Biotech</displayName>
        </li>
        <li>
            <packageId>concordlib.concord</packageId>
            <displayName>Concord</displayName>
            <downloadUrl>https://github.com/ConcordLib/RimWorld/releases/latest</downloadUrl>
        </li>
    </modDependencies>
    <forceLoadAfter>
        <li>Ludeon.RimWorld.Biotech</li>
        <li>concordlib.concord</li>
    </forceLoadAfter>
    <!-- Optional dev tool. When it is active, loadFolders.xml adds the Quickstarts folder
         with Cosmere's own quickstarts in it. -->
    <loadAfter>
        <li>rimworks.quickstarts</li>
    </loadAfter>
</ModMetaData>