<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <WorldObjectDef>
        <defName>Cosmere_Scadrial_WorldObject_Ashmount</defName>
        <label>ashmount</label>
        <description>One of the mountains Rashek raised to cool a world he had pushed too near the sun. It has not stopped since. The ash it throws settles for hundreds of miles, and the land beneath the plume has not seen green in a thousand years.</description>
        <canHaveFaction>false</canHaveFaction>
        <canHaveMap>false</canHaveMap>
        <canBePlayerHome>false</canBePlayerHome>
        <validLaunchTarget>false</validLaunchTarget>
        <selectable>true</selectable>
        <useDynamicDrawer>false</useDynamicDrawer>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>World/Ashmount</expandingIconTexture>
        <expandingIconPriority>60</expandingIconPriority>
        <texture>World/Ashmount</texture>
    </WorldObjectDef>

    <WorldGenStepDef>
        <defName>Cosmere_Scadrial_WorldGenStep_Ashmounts</defName>
        <order>350</order>
        <worldGenStep Class="Cosmere.System.Scadrial.World.WorldGenStep_Ashmounts" />
    </WorldGenStepDef>

</Defs>
