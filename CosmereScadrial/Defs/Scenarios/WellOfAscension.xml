<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>Cosmere_Scadrial_Scenario_WellOfAscension</defName>
    <label>Mistborn: Well of Ascension</label>
    <description>The Lord Ruler is dead, and the world he held together is coming apart. Three armies converge on Luthadel. Elend Venture holds the city with idealism and a stack of political philosophy. Vin watches from the rooftops. The siege begins.</description>
