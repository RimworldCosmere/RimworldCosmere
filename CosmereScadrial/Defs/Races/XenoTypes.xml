<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_Noble</defName>
        <label>scadrian noble</label>
        <description>Nobles are elite descendants of ancient bloodlines, often gifted with Allomantic abilities and steeped in power, tradition, and influence.</description>
        <displayPriority>5002</displayPriority>
        <inheritable>true</inheritable>
        <iconPath>UI/Icons/Xenotype/Noble</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_NobleHeritage</li>
            <li>Cosmere_Scadrial_Gene_NobleHighSocial</li>
            <li>Cosmere_Scadrial_Gene_NobleFastLearner</li>
            <li>Cosmere_Scadrial_Gene_NobleLowFertility</li>
            <li>Cosmere_Scadrial_Gene_NobleLowWorkDrive</li>
        </genes>
    </XenotypeDef>
    
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_Scadrian</defName>
        <label>scadrian</label>
        <description>Scadrians are the unified descendants of both Skaa and Nobility following the Catacendre. Strong, capable, and socially adaptive.</description>
        <displayPriority>4999</displayPriority>
        <inheritable>true</inheritable>
        <iconPath>UI/Icons/Xenotype/Noble</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_ScadrianHeritage</li>
            <li>Cosmere_Scadrial_Gene_SkaaHighFertility</li>
            <li>Cosmere_Scadrial_Gene_SkaaEndurance</li>
            <li>Cosmere_Scadrial_Gene_NobleHighSocial</li>
            <li>Cosmere_Scadrial_Gene_NobleFastLearner</li>
        </genes>
    </XenotypeDef>
    
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_Skaa</defName>
        <label>skaa</label>
        <description>The Skaa are a hardy underclass bred for labor, possessing high fertility and endurance but diminished intellect and social capabilities. They are barred from ideology participation and cannot be born with Metalborn genes unless through noble or Terris lineage.</description>
        <displayPriority>5001</displayPriority>
        <inheritable>true</inheritable>
        <iconPath>UI/Icons/Xenotype/Skaa</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_SkaaHeritage</li>
            <li>Cosmere_Scadrial_Gene_SkaaLowSocial</li>
            <li>Cosmere_Scadrial_Gene_SkaaLowLearning</li>
            <li>Cosmere_Scadrial_Gene_SkaaHighFertility</li>
            <li>Cosmere_Scadrial_Gene_SkaaEndurance</li>
            <li>Cosmere_Scadrial_Gene_SkaaAgnostic</li>
            <li>Cosmere_Scadrial_Gene_SkaaPurity</li>
        </genes>
    </XenotypeDef>
    
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_Terris</defName>
        <label>terris</label>
        <description>A reclusive people known for their cultural memory and Feruchemical potential.</description>
        <displayPriority>5000</displayPriority>
        <inheritable>true</inheritable>
        <iconPath>UI/Icons/Xenotype/Terris</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_TerrisHeritage</li>
            <!-- The Terris are a dark-skinned people. Set on the xenotype rather than per pawn
                 so Sazed, Tindwyl and every generated Terris agree. -->
            <li>Skin_Melanin8</li>
            <li>Cosmere_Scadrial_Gene_TerrisDeepMemory</li>
            <li>Cosmere_Scadrial_Gene_TerrisPeaceful</li>
            <li>Cosmere_Scadrial_Gene_TerrisStability</li>
        </genes>
    </XenotypeDef>

    <!-- Made, never born. A koloss is what four spikes leave behind, so this xenotype is not
         inheritable - koloss who breed produce koloss-blooded children instead, which
         KolossBirthPatch handles. -->
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_Koloss</defName>
        <label>koloss</label>
        <description>Four spikes, driven in at once, and what walks away is not the person who lay down. A koloss is enormous, blue-grey and slow of thought, and it grows for the rest of its life until its own skin gives out.</description>
        <displayPriority>5100</displayPriority>
        <inheritable>false</inheritable>
        <iconPath>UI/Icons/Xenotype/Koloss</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_KolossHeritage</li>
            <li>Cosmere_Scadrial_Gene_NeverStopsGrowing</li>
            <li>Cosmere_Scadrial_Gene_SkinTooSmall</li>
            <li>Cosmere_Scadrial_Gene_SpikeBound</li>
            <li>Cosmere_Scadrial_Gene_EasilyInfluenced</li>
            <li>Cosmere_Scadrial_Gene_DeadenedNerves</li>
        </genes>
    </XenotypeDef>

    <!-- After the Catacendre. Koloss breed true now, and their children are people - taller and
         stronger than their neighbours, and entirely sane. At twelve one of them may choose the
         spikes and stop being this. -->
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_KolossBlooded</defName>
        <label>koloss-blooded</label>
        <description>Harmony left the koloss able to father children, and those children are men and women. A koloss-blooded person stands a head above the crowd and is stronger than they look, and that is the whole of the inheritance.</description>
        <displayPriority>5050</displayPriority>
        <inheritable>true</inheritable>
        <iconPath>UI/Icons/Xenotype/KolossBlooded</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_KolossBlooded</li>
            <li>Cosmere_Scadrial_Gene_ScadrianHeritage</li>
        </genes>
    </XenotypeDef>

    <!-- Made from a mistwraith by driving two spikes into it, so nothing about a kandra is
         inherited. They do not have children. -->
    <XenotypeDef>
        <defName>Cosmere_Scadrial_Xenotype_Kandra</defName>
        <label>kandra</label>
        <description>A boneless thing wearing somebody else's shape, held together by two hemalurgic spikes. Kandra serve under contract, count their generations, and remember a great deal more than they admit to.</description>
        <displayPriority>5120</displayPriority>
        <inheritable>false</inheritable>
        <iconPath>UI/Icons/Xenotype/Kandra</iconPath>
        <genes>
            <li>Cosmere_Scadrial_Gene_KandraHeritage</li>
            <li>Cosmere_Scadrial_Gene_Boneless</li>
            <li>Cosmere_Scadrial_Gene_TrueBody</li>
            <li>Cosmere_Scadrial_Gene_BlessingBound</li>
            <li>Cosmere_Scadrial_Gene_BodyAbsorption</li>
            <li>Cosmere_Scadrial_Gene_Generational</li>
        </genes>
    </XenotypeDef>

</Defs>
