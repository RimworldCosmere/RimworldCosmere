<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <Cosmere.Core.Quest.CosmereQuestDef>
        <defName>Cosmere_Scadrial_Quest_PitsOfHathsin</defName>
        <label>The Pits Themselves</label>
        <description>The survivor's seam was a splinter off something far larger. The Pits of Hathsin are not a mine. They are a farm, and the crop is atium, and the Lord Ruler has worked it with skaa for a thousand years because no one who goes in comes out to say otherwise.\n\nYou know where it is now. So does the Ministry, and they have never had to defend it before, because nobody has ever been mad enough to walk in.\n\nBreak the guard and work the basin out. The atium is yours as you cut it. What you take from him is worth more than what you carry away.</description>

        <kind>Capstone</kind>
        <subject>Colony</subject>
        <eras>
            <li>Cosmere_Scadrial_Era_PreCatacendre</li>
        </eras>

        <giverFaction>Cosmere_Scadrial_Faction_SkaaRebels</giverFaction>
        <targetFaction>Cosmere_Scadrial_Faction_FinalEmpireNPC</targetFaction>

        <requiredFlags>
            <li>HathsinLead</li>
        </requiredFlags>

        <!-- 0 means the offer never lapses. One farm, one campaign. -->
        <expireAfterDays>0</expireAfterDays>
        <cooldownDays>30</cooldownDays>
        <challengeRating>5</challengeRating>
        <minColonists>4</minColonists>

        <stages>
            <li>
                <key>travel</key>
                <descriptionKey>CS_Quest_Pits_Stage_Travel</descriptionKey>
                <objective Class="Cosmere.Core.Quest.Objective.TravelToSiteObjective">
                    <!-- The crystal is the site. PreciousLump would drop a second, unconnected
                         blob of its own, and the dendrite publishes RectOfInterest itself. -->
                    <sitePart>Cosmere_Scadrial_SitePart_AtiumField</sitePart>
                    <extraSiteParts>
                        <li>Cosmere_Scadrial_SitePart_MinistryGarrison</li>
                        <!-- Our own outpost part rather than vanilla's: it generates after the
                             dendrite so GenStep_Outpost sees RectOfInterest and walls the fort
                             in BESIDE the ore instead of on top of it. -->
                        <li>Cosmere_Scadrial_SitePart_MinistryOutpost</li>
                    </extraSiteParts>
                    <siteLabelKey>CS_Quest_Pits_Site</siteLabelKey>
                    <!-- Encounter scatters ancient ruins over the whole map. Next to a crystal
                         field this size they are just clutter with better prefabs. -->
                    <worldObject>Cosmere_WorldObject_QuestSite</worldObject>
                    <!-- The crystal needs open, diggable ground. An atoll or an ice sheet has
                         nowhere for it to grow, and deep water tiles read as open sea. -->
                    <allowedBiomes>
                        <li>TemperateForest</li>
                        <li>AridShrubland</li>
                        <li>Desert</li>
                        <li>BorealForest</li>
                    </allowedBiomes>
                    <allowedHilliness>
                        <li>SmallHills</li>
                        <li>LargeHills</li>
                    </allowedHilliness>
                    <minTiles>14</minTiles>
                    <maxTiles>28</maxTiles>
                    <threatPoints>1400</threatPoints>
                    <!-- The player is meant to shuttle loads home, so the site has to survive
                         every departure and re-arm on the next visit. -->
                    <persistent>true</persistent>
                </objective>
            </li>
            <li>
                <key>strip</key>
                <descriptionKey>CS_Quest_Pits_Stage_Carry</descriptionKey>
                <objective Class="Cosmere.Core.Quest.Objective.MineOutSiteObjective">
                    <mineable>MineableAtium</mineable>
                    <fraction>0.85</fraction>
                </objective>
            </li>
        </stages>

        <rewards>
            <!-- No atium here on purpose. The field itself pays that out as it is cut, and by
                 the time the Pits fall the colony is not short of it. What it has not had is
                 any reason to believe the Lord Ruler can be taken from. -->
            <li Class="Cosmere.Core.Quest.Reward.ColonyThoughtReward">
                <thought>Cosmere_Scadrial_PitsBroken</thought>
            </li>
            <li Class="Cosmere.Core.Quest.Reward.GoodwillReward">
                <faction>Cosmere_Scadrial_Faction_SkaaRebels</faction>
                <goodwill>60</goodwill>
            </li>
            <li Class="Cosmere.System.Scadrial.Quest.AwakenConnectionReward">
                <shard>Preservation</shard>
                <countMin>1</countMin>
                <countMax>2</countMax>
                <connectionGain>1.0</connectionGain>
            </li>
            <li Class="Cosmere.Core.Quest.Reward.FlagReward">
                <flag>PitsBroken</flag>
            </li>
        </rewards>

        <onFailure Class="Cosmere.Core.Quest.Outcome.NeverBurns" />
    </Cosmere.Core.Quest.CosmereQuestDef>
</Defs>
