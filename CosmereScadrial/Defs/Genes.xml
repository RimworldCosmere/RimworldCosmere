<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <GeneDef Name="AbstractMetallicArtsInvestitureGene" Abstract="True">
        <randomChosen>false</randomChosen>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <passOnDirectly>false</passOnDirectly>
        <biostatCpx>500</biostatCpx>
        <biostatMet>500</biostatMet>
        <biostatArc>500</biostatArc>
        <modExtensions>
            <li Class="Cosmere.Core.DefModExtension.CollapsibleGizmo">
                <defaultCollapsed>true</defaultCollapsed>
            </li>
            <li Class="Cosmere.Core.DefModExtension.DormantConnection">
                <callbackHandler>Cosmere.Scadrial.DormantConnection.Callback.Snapped</callbackHandler>
            </li>
        </modExtensions>
        <statOffsets>
            <MarketValue>20</MarketValue>
        </statOffsets>
    </GeneDef>
    <GeneDef Name="AbstractAllomancyInvestitureGene" ParentName="AbstractMetallicArtsInvestitureGene" Abstract="True">
        <geneClass>Cosmere.Scadrial.Gene.Allomancer</geneClass>
        <resourceGizmoType>Cosmere.Scadrial.Gizmo.AllomanticGeneCommand</resourceGizmoType>
        <resourceGizmoThresholds>
            <li>0.2</li>
            <li>0.4</li>
            <li>0.6</li>
            <li>0.8</li>
        </resourceGizmoThresholds>
        <showGizmoOnWorldView>true</showGizmoOnWorldView>
        <showGizmoWhenDrafted>true</showGizmoWhenDrafted>
    </GeneDef>
    <GeneDef Name="AbstractFeruchemyInvestitureGene" ParentName="AbstractMetallicArtsInvestitureGene" Abstract="True">
        <geneClass>Cosmere.Scadrial.Gene.Feruchemist</geneClass>
        <resourceGizmoType>Cosmere.Scadrial.Gizmo.FeruchemicGeneCommand</resourceGizmoType>
        <resourceGizmoThresholds>
            <li>0.2</li>
            <li>0.4</li>
            <li>0.6</li>
            <li>0.8</li>
        </resourceGizmoThresholds>
        <showGizmoOnWorldView>true</showGizmoOnWorldView>
        <showGizmoWhenDrafted>true</showGizmoWhenDrafted>
    </GeneDef>
</Defs>