  <!-- The Diagram: Taravangian's night of brilliance, read as scripture -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Diagram</defName>
    <label>the Diagram</label>
    <fixedName>The Diagram</fixedName>
    <description>A conspiracy built around a single night's writing by a man who traded most of his compassion for a day of impossible brilliance, and who has been trying to read his own handwriting ever since.\n\nIts followers treat that text as prophecy. Where the world has diverged from it, they work to force the world back.</description>
    <pawnSingular>Diagramist</pawnSingular>
    <pawnsPlural>Diagramists</pawnsPlural>
    <hidden>true</hidden>
    <!-- In the configurable list so world generation actually creates it, but not drawn:
         a society nobody has heard of should not be a row the player ticks. hidden keeps it
         out of the twelve-faction cap and off the map as a settlement. -->
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <listOrderPriority>26</listOrderPriority>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <canMakeRandomly>false</canMakeRandomly>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Interpreter</leaderTitle>
    <factionIconPath>World/WorldObjects/Expanding/TownRough</factionIconPath>
    <colorSpectrum>
      <li>(0.3, 0.25, 0.35)</li>
      <li>(0.45, 0.4, 0.55)</li>
    </colorSpectrum>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.7</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.3</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Slasher>12</Mercenary_Slasher>
          <Mercenary_Elite>8</Mercenary_Elite>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>15</Villager>
          <Town_Guard>10</Town_Guard>
          <Town_Councilman>4</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>12</Villager>
          <Town_Guard>15</Town_Guard>
          <Mercenary_Slasher>8</Mercenary_Slasher>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
  </FactionDef>

</Defs>
