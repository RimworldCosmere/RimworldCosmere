<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <Cosmere.System.Scadrial.Def.AllomanticAbilityDef ParentName="AbstractToggleSelfBurnAbility">
        <defName>Cosmere_Scadrial_Ability_BrassAura</defName>
        <label>soothing aura</label>
        <description>Suppress emotional outbursts and calm the minds of others using Brass. Has a chance to break mental states when flaring.</description>
        <metal>Brass</metal>
        <canUseWhileAsleep>true</canUseWhileAsleep>
        <hediff>Cosmere_Scadrial_Hediff_BrassAura</hediff>
        <maxPower>2</maxPower>
    </Cosmere.System.Scadrial.Def.AllomanticAbilityDef>
    <Cosmere.System.Scadrial.Def.AllomanticAbilityDef ParentName="AbstractToggleTargetBurnAbility">
        <defName>Cosmere_Scadrial_Ability_BrassTarget</defName>
        <label>soothe target</label>
        <description>Suppress emotional outburst and calm the mind of a target Brass. Has a chance to break mental states.</description>
        <metal>Brass</metal>
        <hediff>Cosmere_Scadrial_Hediff_Soothed</hediff>
        <hediffSeverityFactor>2</hediffSeverityFactor>
        <verbProperties>
            <targetParams>
                <canTargetItems>false</canTargetItems>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetMechs>false</canTargetMechs>
                <canTargetPlants>false</canTargetPlants>
            </targetParams>
        </verbProperties>
        <maxPower>2</maxPower>
        <!-- Seizing a koloss or a kandra is the same push, aimed at something that can be owned.
             The comp answers with both numbers when the target resists, so the player can see how
             far short they fell and that duralumin closes it. -->
        <comps>
            <li Class="Cosmere.System.Scadrial.Allomancy.Comp.Ability.SeizeKolossProperties" />
        </comps>
    </Cosmere.System.Scadrial.Def.AllomanticAbilityDef>
</Defs>