    </SpecialThingFilterDef>

    <SpecialThingFilterDef>
        <defName>Cosmere_Scadrial_SpecialFilter_NotSpikeTin</defName>
        <label>spikes that are not tin</label>
        <description>Rejects hemalurgic spikes made of anything but tin.</description>
