<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The mod itself is net48, but the .NET SDK ships no net48 test host for
             Linux, so `dotnet test` cannot run one there. These tests deliberately
             touch nothing that needs Unity or Verse, which lets them target a modern
             runtime and run on every machine the mod is developed on. -->
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Referencing the net48 project is intentional and limited to GaugeMath,
             which is plain System.Math and loads cleanly. -->
        <!-- MSTEST0032 calls a constant-guard assertion always-true, because the compiler folds
             the const at this compilation. It still fails the moment somebody edits the value,
             which is the entire job of those tests. -->
        <NoWarn>$(NoWarn);NU1701;NU1702;CS8032;MSTEST0032</NoWarn>
        <OutDir>bin\$(Configuration)\</OutDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>
        <PackageReference Include="MSTest.TestAdapter" Version="4.4.0"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.4.0"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CosmereCore\CosmereCore\Cosmere.csproj"/>
    </ItemGroup>
</Project>
