<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Base for Roshar NPC factions -->
  <FactionDef ParentName="FactionBase" Name="Cosmere_Roshar_NPCFactionBase" Abstract="True">
    <techLevel>Medieval</techLevel>
    <factionNameMaker>NamerFactionTribal</factionNameMaker>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <allowedCultures><li>Astropolitan</li></allowedCultures>
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
  </FactionDef>

  <!-- Listeners/Parshendi: The singer people, neutral -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Listeners</defName>
    <label>listener tribe</label>
    <fixedName>The Listeners</fixedName>
    <description>The listeners are singers who have maintained their free will, unlike the parshmen enslaved by the Alethi. They live in the chasms and plateaus of the Shattered Plains, following the ancient rhythms of Roshar.\n\nThey are wary of outsiders but not inherently hostile - unless provoked.</description>
    <pawnSingular>listener</pawnSingular>
    <pawnsPlural>listeners</pawnsPlural>
    <listOrderPriority>55</listOrderPriority>
    <settlementGenerationWeight>0.8</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Warlord</leaderTitle>
    <factionIconPath>World/WorldObjects/Expanding/Village</factionIconPath>
    <colorSpectrum>
      <li>(0.4, 0.2, 0.2)</li>
      <li>(0.6, 0.3, 0.3)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>55</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">Parshendi Rhythms</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">The listeners follow the rhythms of Roshar, seeking meaning in song and pattern.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_ParshendriRhythms</li>
    </forcedMemes>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Tribesperson>10</Tribesperson>
          <Tribal_Archer>8</Tribal_Archer>
          <Tribal_Berserker>6</Tribal_Berserker>
          <Tribal_ChiefMelee>4</Tribal_ChiefMelee>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Tribesperson>15</Tribesperson>
          <Tribal_Archer>5</Tribal_Archer>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Tribesperson>15</Tribesperson>
          <Tribal_Archer>8</Tribal_Archer>
          <Tribal_ChiefMelee>4</Tribal_ChiefMelee>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>TribeRaidLootMaker</raidLootMaker>
  </FactionDef>

  <!-- Alethkar: the Vorin war-kingdom, Gavilar's and then Elhokar's -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Alethkar</defName>
    <label>Alethkar</label>
    <fixedName>Alethkar</fixedName>
    <description>The greatest of the Vorin kingdoms, and the most warlike. Ten highprinces answer to its king, each with his own army, his own lands and his own reasons to resent the other nine.\n\nAlethi society is built on the Thrill and on rank. A lighteyed officer expects deference. A darkeyed soldier expects to earn his way up by the spear, and usually dies before he does.</description>
    <pawnSingular>Alethi</pawnSingular>
    <pawnsPlural>Alethi</pawnsPlural>
    <listOrderPriority>60</listOrderPriority>
    <settlementGenerationWeight>0.9</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>King</leaderTitle>
    <leaderTitleFemale>Queen</leaderTitleFemale>
    <factionIconPath>World/WorldObjects/Expanding/TownRough</factionIconPath>
    <naturalEnemy>true</naturalEnemy>
    <permanentEnemy>false</permanentEnemy>
    <colorSpectrum>
      <li>(0.2, 0.3, 0.5)</li>
      <li>(0.3, 0.4, 0.7)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>5</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>60</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">Vorinism</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">The dominant faith of Alethkar, centered on the Almighty and the ten Heralds.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_Vorinism</li>
    </forcedMemes>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.75</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.25</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Slasher>12</Mercenary_Slasher>
          <Mercenary_Elite>8</Mercenary_Elite>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>10</Villager>
          <Town_Guard>12</Town_Guard>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>10</Villager>
          <Town_Guard>15</Town_Guard>
          <Mercenary_Slasher>10</Mercenary_Slasher>
          <Mercenary_Elite>5</Mercenary_Elite>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
  </FactionDef>

  <!-- Thaylenah: the island trade nation, and the Passions -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Thaylenah</defName>
    <label>Thaylenah</label>
    <fixedName>Thaylenah</fixedName>
    <description>An island kingdom of sailors and traders, ringed by mountains that break the highstorms before they reach Thaylen City. Its Council of Merchants holds nearly as much power as its throne.\n\nThaylens wear their eyebrows long and their ledgers longer. They follow the Passions, and they will trade with anyone who deals honestly.</description>
    <pawnSingular>Thaylen</pawnSingular>
    <pawnsPlural>Thaylens</pawnsPlural>
    <listOrderPriority>50</listOrderPriority>
    <settlementGenerationWeight>0.7</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <leaderTitle>King</leaderTitle>
    <leaderTitleFemale>Queen</leaderTitleFemale>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <colorSpectrum>
      <li>(0.5, 0.4, 0.6)</li>
      <li>(0.7, 0.6, 0.8)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>50</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">The Passions</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">Thaylens follow the Passions, believing strong emotions drive success and honor.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_Passions</li>
    </forcedMemes>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.7</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.3</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_Exotic</li>
      <li>Caravan_Outlander_CombatSupplier</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Gunner>8</Mercenary_Gunner>
          <Mercenary_Elite>5</Mercenary_Elite>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>15</Villager>
          <Town_Guard>8</Town_Guard>
          <Town_Councilman>5</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Town_Trader>1</Town_Trader>
        </traders>
        <carriers>
          <Muffalo>8</Muffalo>
          <Alpaca>4</Alpaca>
          <Elephant>2</Elephant>
        </carriers>
        <guards>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Gunner>8</Mercenary_Gunner>
          <Mercenary_Elite>4</Mercenary_Elite>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>15</Villager>
          <Town_Guard>10</Town_Guard>
          <Town_Councilman>5</Town_Councilman>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
  </FactionDef>

  <!-- Shinovar: soil, grass, and stone that must not be walked on -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Shinovar</defName>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.8</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.2</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <label>Shinovar</label>
    <fixedName>Shinovar</fixedName>
    <description>The only land on Roshar with deep soil and grass that does not withdraw when touched. The mountains take the highstorms, so Shinovar grows crops the rest of the world has never seen.\n\nThe Shin hold stone sacred and will not walk on it uncovered. They honour farmers above all, and hold warriors in open contempt - which has not stopped them training some of the most dangerous killers alive.</description>
    <pawnSingular>Shin</pawnSingular>
    <pawnsPlural>Shin</pawnsPlural>
    <listOrderPriority>45</listOrderPriority>
    <techLevel>Neolithic</techLevel>
    <settlementGenerationWeight>0.5</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <leaderTitle>Farmer</leaderTitle>
    <factionIconPath>World/WorldObjects/Expanding/Village</factionIconPath>
    <colorSpectrum>
      <li>(0.3, 0.5, 0.3)</li>
      <li>(0.5, 0.7, 0.4)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>2</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>45</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">Stone Shamanism</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">Stone is sacred. To walk on stone is to be a warrior, deserving of contempt. Farmers are the most honored.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_StoneShamanism</li>
    </forcedMemes>
    <caravanTraderKinds>
      <li>Caravan_Neolithic_BulkGoods</li>
    </caravanTraderKinds>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Tribesperson>10</Tribesperson>
          <Tribal_Archer>5</Tribal_Archer>
          <Tribal_ChiefMelee>8</Tribal_ChiefMelee>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Tribesperson>20</Tribesperson>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Tribal_Trader>1</Tribal_Trader>
        </traders>
        <carriers>
          <Muffalo>5</Muffalo>
        </carriers>
        <guards>
          <Tribesperson>8</Tribesperson>
          <Tribal_ChiefMelee>4</Tribal_ChiefMelee>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Tribesperson>20</Tribesperson>
          <Tribal_ChiefMelee>5</Tribal_ChiefMelee>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>TribeRaidLootMaker</raidLootMaker>
  </FactionDef>

  <!-- Jah Keved: the second Vorin kingdom, and Alethkar's rival -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_JahKeved</defName>
    <label>Jah Keved</label>
    <fixedName>Jah Keved</fixedName>
    <description>The second of the Vorin kingdoms, and the one Alethkar measures itself against. Vedens are darker of skin than their eastern neighbours and just as fond of a Shardblade.\n\nIts highprinces have spent a generation feuding over the succession. A Veden noble counts allies the way a merchant counts spheres, and trusts them about as far.</description>
    <pawnSingular>Veden</pawnSingular>
    <pawnsPlural>Vedens</pawnsPlural>
    <listOrderPriority>58</listOrderPriority>
    <settlementGenerationWeight>0.85</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>King</leaderTitle>
    <leaderTitleFemale>Queen</leaderTitleFemale>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <colorSpectrum>
      <li>(0.5, 0.15, 0.15)</li>
      <li>(0.7, 0.25, 0.25)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>58</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">The Veden Devotary</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">The Almighty set the Heralds to guard mankind, and rank is the shape His order takes.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_Vorinism</li>
    </forcedMemes>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.78</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.22</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Slasher>12</Mercenary_Slasher>
          <Mercenary_Elite>8</Mercenary_Elite>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>15</Villager>
          <Town_Guard>10</Town_Guard>
          <Town_Councilman>4</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>12</Villager>
          <Town_Guard>15</Town_Guard>
          <Mercenary_Slasher>8</Mercenary_Slasher>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
  </FactionDef>

  <!-- Kharbranth: the city of bells, its hospitals and the Palanaeum -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Kharbranth</defName>
    <label>Kharbranth</label>
    <fixedName>Kharbranth</fixedName>
    <description>A city-state built into a bay too sheltered for the highstorms to ruin, ruled by a king who has outlived his usefulness to nobody. Kharbranth keeps no army worth the name and has never needed one.\n\nIts hospitals take any patient who can reach them. Beneath the palace, the Palanaeum holds more books than the rest of Roshar together, and scholars come from every nation to read them.</description>
    <pawnSingular>Kharbranthian</pawnSingular>
    <pawnsPlural>Kharbranthians</pawnsPlural>
    <listOrderPriority>52</listOrderPriority>
    <settlementGenerationWeight>0.6</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>King</leaderTitle>
    <leaderTitleFemale>Queen</leaderTitleFemale>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <colorSpectrum>
      <li>(0.85, 0.75, 0.45)</li>
      <li>(0.95, 0.88, 0.6)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>52</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">The Devotary of Sincerity</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">Learning is a Calling like any other, and the Almighty is served as well by a scholar as by a soldier.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_Vorinism</li>
    </forcedMemes>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.82</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.18</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Slasher>12</Mercenary_Slasher>
          <Mercenary_Elite>8</Mercenary_Elite>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>15</Villager>
          <Town_Guard>10</Town_Guard>
          <Town_Councilman>4</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>12</Villager>
          <Town_Guard>15</Town_Guard>
          <Mercenary_Slasher>8</Mercenary_Slasher>
        </options>
      </li>
    </pawnGroupMakers>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
  </FactionDef>

  <!-- Azir: the bureaucratic empire, and Yaezir's ledgers -->
  <FactionDef ParentName="Cosmere_Roshar_NPCFactionBase">
    <defName>Cosmere_Roshar_Faction_Azir</defName>
    <label>Azir</label>
    <fixedName>The Azish Empire</fixedName>
    <description>An empire run by its clerks. Every decision of consequence is written, stamped, filed and appealed, and an Azish official would sooner lose a province than lose the paperwork proving it was his.\n\nIts throne goes to whoever submits the most persuasive essay. This sounds absurd to every other nation on Roshar, and has given Azir the most stable succession on the continent.</description>
    <pawnSingular>Azish</pawnSingular>
    <pawnsPlural>Azish</pawnsPlural>
    <listOrderPriority>56</listOrderPriority>
    <settlementGenerationWeight>0.8</settlementGenerationWeight>
    <canMakeRandomly>true</canMakeRandomly>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Prime Aqasix</leaderTitle>
    <leaderTitleFemale>Prime Aqasix</leaderTitleFemale>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <colorSpectrum>
      <li>(0.85, 0.6, 0.15)</li>
      <li>(0.95, 0.75, 0.3)</li>
    </colorSpectrum>
    <maxConfigurableAtWorldCreation>2</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>56</configurationListOrderPriority>
    <fixedIdeo MayRequire="Ludeon.RimWorld.Ideology">true</fixedIdeo>
    <ideoName MayRequire="Ludeon.RimWorld.Ideology">Yaezirism</ideoName>
    <ideoDescription MayRequire="Ludeon.RimWorld.Ideology">Yaezir is petitioned in writing, through the proper offices, and the reply is filed.</ideoDescription>
    <forcedMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Cosmere_Structure_Yaezirism</li>
    </forcedMemes>
    <xenotypeSet>
      <xenotypeChances>
        <Cosmere_Roshar_Xenotype_Darkeyes>0.9</Cosmere_Roshar_Xenotype_Darkeyes>
        <Cosmere_Roshar_Xenotype_Lighteyes>0.1</Cosmere_Roshar_Xenotype_Lighteyes>
      </xenotypeChances>
    </xenotypeSet>
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_Exotic</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Town_Guard>10</Town_Guard>
          <Mercenary_Slasher>12</Mercenary_Slasher>
          <Mercenary_Elite>8</Mercenary_Elite>
          <Town_Councilman>3</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Villager>15</Villager>
          <Town_Guard>10</Town_Guard>
          <Town_Councilman>4</Town_Councilman>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Villager>12</Villager>
          <Town_Guard>15</Town_Guard>
          <Mercenary_Slasher>8</Mercenary_Slasher>
        </options>
      </li>
    </pawnGroupMakers>
