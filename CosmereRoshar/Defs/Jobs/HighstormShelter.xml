<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <JobDef>
        <defName>Cosmere_Roshar_GoToHighstormShelter</defName>
        <label>go to highstorm shelter</label>
        <driverClass>Cosmere.System.Roshar.JobDriver.GoToHighstormShelter</driverClass>
        <reportString>seeking shelter from the highstorm.</reportString>
        <playerInterruptible>false</playerInterruptible>
        <casualInterruptible>false</casualInterruptible>
        <collideWithPawns>false</collideWithPawns>
        <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    </JobDef>

    <JobDef>
        <defName>Cosmere_Roshar_WaitInHighstormShelter</defName>
        <label>wait in highstorm shelter</label>
        <driverClass>Cosmere.System.Roshar.JobDriver.WaitInHighstormShelter</driverClass>
        <reportString>sheltering from the highstorm.</reportString>
        <playerInterruptible>false</playerInterruptible>
        <casualInterruptible>false</casualInterruptible>
        <checkOverrideOnDamage>Never</checkOverrideOnDamage>
        <suspendable>false</suspendable>
    </JobDef>
</Defs>
