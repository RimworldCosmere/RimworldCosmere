              </skills>
            </li>
            <li>
              <firstName>Steris</firstName>
              <lastName>Harms</lastName>
              <age>36</age>
              <gender>Female</gender>
              <xenotype>Cosmere_Scadrial_Xenotype_Noble</xenotype>
              <traits>
                <li><def>Industriousness</def><degree>2</degree></li>
                <li><def>Nerves</def><degree>2</degree></li>
              </traits>
              <skills>
                <li><def>Intellectual</def><level>16</level></li>
                <li><def>Social</def><level>12</level></li>
                <li><def>Crafting</def><level>10</level></li>
              </skills>
            </li>
            <li>
              <firstName>MeLaan</firstName>
              <age>24</age>
              <gender>Female</gender>
              <xenotype>Cosmere_Scadrial_Xenotype_Scadrian</xenotype>
              <traits>
                <li><def>Nerves</def><degree>2</degree></li>
              </traits>
              <skills>
                <li><def>Melee</def><level>15</level></li>
                <li><def>Social</def><level>13</level></li>
                <li><def>Intellectual</def><level>11</level></li>
              </skills>
            </li>
          </pawns>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealFine</thingDef>
          <count>80</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
