<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>Cosmere_Scadrial_Thing_VialCabinet</defName>
        <label>vial cabinet</label>
        <description>A wooden case lined with rows of drilled slots, each sized to hold a single allomantic vial upright. The kind of thing you'd find in any Mistborn crew's safehouse, stocked and ready for the night's work.</description>
        <thingClass>Cosmere.System.Scadrial.Thing.Building_VialCabinet</thingClass>
        <graphicData>
            <texPath>Things/Building/VialCabinet/VialCabinet</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(4,2.75)</drawSize>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <size>(2,1)</size>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.4</fillPercent>
        <pathCost>50</pathCost>
        <canOverlapZones>false</canOverlapZones>
        <rotatable>true</rotatable>
        <surfaceType>Item</surfaceType>
        <defaultPlacingRot>South</defaultPlacingRot>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.5</staticSunShadowHeight>
        <designationCategory>Furniture</designationCategory>
        <inspectorTabs>
            <li>ITab_Storage</li>
        </inspectorTabs>
        <stuffCategories>
            <li>Woody</li>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>30</costStuffCount>
        <building>
            <maxItemsInCell>200</maxItemsInCell>
            <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
            <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
            <blueprintClass>Blueprint_Storage</blueprintClass>
            <fixedStorageSettings>
                <filter>
                    <disallowNotEverStorable>true</disallowNotEverStorable>
                    <categories>
                        <li>Cosmere_Scadrial_ThingCategory_Allomancy</li>
                    </categories>
                </filter>
            </fixedStorageSettings>
            <defaultStorageSettings>
                <priority>Important</priority>
                <filter>
                    <categories>
                        <li>Cosmere_Scadrial_ThingCategory_Allomancy</li>
                    </categories>
                </filter>
            </defaultStorageSettings>
        </building>
        <researchPrerequisites>
            <li>Cosmere_Scadrial_Allomancy</li>
        </researchPrerequisites>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>1500</WorkToBuild>
            <Mass>8</Mass>
            <Flammability>1.0</Flammability>
        </statBases>
    </ThingDef>
</Defs>
